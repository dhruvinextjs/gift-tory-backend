<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>

    <%- include('_layouts/head') %>

    <title>Shipping Policy | <%= title %></title>


    <style>

        /* =========================================
           SHIPPING POLICY PAGE
           Same UI style as Categories / CMS pages
        ========================================= */


        /* Page Header */

        .shipping-page-header {
            margin-bottom: 20px;
        }


        .shipping-page-header h5 {
            margin-bottom: 5px;
        }


        .shipping-page-header p {
            margin-top: 0;
        }


        /* Form Card */

        .shipping-form-card {
            background: #ffffff;

            border-radius: 8px;

            overflow: hidden;

            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);

            border: 1px solid #eeeeee;

            margin-bottom: 30px;
        }


        .shipping-form-body {
            padding: 30px;
        }


        /* Form Section */

        .form-section {
            margin-bottom: 30px;

            padding-bottom: 25px;

            border-bottom: 1px solid #eeeeee;
        }


        .form-section:last-child {
            margin-bottom: 0;

            padding-bottom: 0;

            border-bottom: none;
        }


        /* Section Title */

        .section-title {
            font-size: 16px;

            font-weight: 600;

            color: #333;

            margin: 0 0 20px 0;

            display: flex;

            align-items: center;

            gap: 8px;
        }


        .section-title i {
            color: #26a69a;

            font-size: 20px;
        }


        /* Editor */

        .editor-box {
            width: 100%;

            margin-top: 10px;
        }


        .editor-box label {
            display: block;

            font-size: 13px;

            font-weight: 600;

            color: #555;

            margin-bottom: 8px;
        }


        .required {
            color: #e53935;
        }


        /* CKEditor */

        .ck-editor__editable {
            min-height: 420px;
        }


        .ck.ck-editor {
            width: 100%;
        }


        .ck.ck-editor__main > .ck-editor__editable {
            border-radius: 0 0 4px 4px;
        }


        .ck.ck-toolbar {
            border-radius: 4px 4px 0 0;
        }


        /* Editor Hint */

        .editor-hint {
            font-size: 12px;

            color: #9e9e9e;

            margin-top: 8px;

            display: block;
        }


        /* Form Actions */

        .form-actions {
            display: flex;

            justify-content: flex-end;

            align-items: center;

            gap: 10px;

            margin-top: 25px;

            padding-top: 20px;

            border-top: 1px solid #eeeeee;
        }


        .form-actions .btn {
            border-radius: 4px;

            text-transform: none;

            font-weight: 500;
        }


        .btn-gradient {
            background: linear-gradient(
                135deg,
                #7b1fa2,
                #9c27b0
            );

            box-shadow: 0 3px 8px rgba(123, 31, 162, 0.25);
        }


        .btn-gradient:hover {
            background: linear-gradient(
                135deg,
                #6a1b9a,
                #8e24aa
            );
        }


        /* Responsive */

        @media (max-width: 768px) {

            .shipping-form-body {
                padding: 20px;
            }


            .form-actions {
                justify-content: flex-start;

                flex-wrap: wrap;
            }


            .ck-editor__editable {
                min-height: 300px;
            }

        }


    </style>

</head>


<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click"
    data-menu="vertical-dark-menu"
    data-col="2-columns"
>


    <!-- SIDEBAR -->

    <%- include('_layouts/sidenavbar') %>



    <!-- MAIN -->

    <div id="main">

        <div class="row">


            <!-- Breadcrumb Header -->

            <div
                class="pt-1 pb-0"
                id="breadcrumbs-wrapper"
            >

                <div class="container">

                    <div class="row">


                        <!-- Messages -->

                        <%- include('messages', { messages: messages }) %>



                        <!-- Page Title -->

                        <div class="col s12 m6 l6">

                            <h6 class="breadcrumbs-title">

                                Shipping Policy

                            </h6>

                        </div>



                        <!-- Breadcrumbs -->

                        <div
                            class="col s12 m6 l6 right-align-md"
                            style="margin-top:-10px;"
                        >

                            <ol class="breadcrumbs mb-0">

                                <li class="breadcrumb-item">

                                    <a href="/admin/dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="breadcrumb-item active">

                                    Shipping Policy

                                </li>

                            </ol>

                        </div>

                    </div>



                    <!-- Page Header -->

                    <div class="row">

                        <div class="col s12">

                            <div class="shipping-page-header">

                                <h5 class="mt-0">

                                    Shipping Policy

                                </h5>


                                <p class="grey-text">

                                    Update the shipping policy shown on the website

                                </p>

                            </div>

                        </div>

                    </div>



                    <!-- Main Content -->

                    <div class="col s12">

                        <div class="container">

                            <div class="section">

                                <div class="row">

                                    <div class="col s12">


                                        <!-- Shipping Policy Form -->

                                        <div class="shipping-form-card">

                                            <div class="shipping-form-body">


                                                <form
                                                    method="POST"
                                                    action="/admin/shipping-policy"
                                                >


                                                    <!-- Shipping Policy Section -->

                                                    <div class="form-section">


                                                        <h6 class="section-title">

                                                            <i class="material-icons">

                                                                local_shipping

                                                            </i>

                                                            Shipping Policy Content

                                                        </h6>



                                                        <div class="editor-box">


                                                            <label for="editor">

                                                                Shipping Policy

                                                                <span class="required">

                                                                    *

                                                                </span>

                                                            </label>



                                                            <textarea
                                                                id="editor"
                                                                name="content"
                                                            ><%= policy.content || "" %></textarea>



                                                            <span class="editor-hint">

                                                                Update the shipping policy content that will be displayed on the website.

                                                            </span>


                                                        </div>


                                                    </div>



                                                    <!-- Form Actions -->

                                                    <div class="form-actions">


                                                        <a
                                                            href="/admin/dashboard"
                                                            class="btn grey lighten-1 waves-effect"
                                                        >

                                                            Cancel

                                                        </a>



                                                        <button
                                                            class="btn btn-gradient waves-effect waves-light"
                                                            type="submit"
                                                        >

                                                            <i
                                                                class="material-icons left"
                                                                style="font-size:18px;"
                                                            >

                                                                save

                                                            </i>

                                                            Save Changes

                                                        </button>


                                                    </div>


                                                </form>


                                            </div>

                                        </div>


                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                </div>

            </div>


        </div>

    </div>



    <!-- COMMON JS -->

    <%- include('_layouts/commonJs') %>



    <!-- CKEDITOR -->

    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>



    <script>

        document.addEventListener('DOMContentLoaded', function () {


            /* =========================================
               Initialize CKEditor
            ========================================= */

            const editorElement =
                document.querySelector('#editor');


            if (editorElement) {

                ClassicEditor
                    .create(editorElement)
                    .catch(function (error) {

                        console.error(error);

                    });

            }


        });

    </script>


</body>

</html>