<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>

    <%- include('_layouts/head') %>

    <title>Testimonials | <%= title %></title>

    <!-- DataTables CSS -->
    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/select.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/css/pages/data-tables.css"
    >

    <style>

        /* =========================================
           TESTIMONIALS PAGE
           Same UI style as Categories page
        ========================================= */

        /* Table */

        table tr td,
        table tr th {

            text-align: center;

            vertical-align: middle !important;

            padding: 10px 8px !important;

        }


        /* Testimonial image */

        .testimonial-table-image {

            width: 50px;

            height: 50px;

            object-fit: cover;

            border-radius: 50%;

            border: 1px solid #eeeeee;

            display: inline-block;

        }


        /* Name */

        .testimonial-name {

            font-weight: 600;

            color: #333;

        }


        /* Designation */

        .testimonial-designation {

            display: block;

            color: #999;

            font-size: 12px;

            margin-top: 3px;

        }


        /* Rating */

        .testimonial-rating {

            font-weight: 600;

            color: #f59e0b;

            white-space: nowrap;

        }


        /* Message */

        .testimonial-message {

           display: -webkit-box;
    color: #757575;
    font-size: 13px;
    line-height: 18px;
    max-width: 250px;
    margin: 0 auto;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;

        }


        /* Status */

        .testimonial-status {

            padding: 16px 12px;

            border-radius: 20px;

            font-size: 0.8rem;

            font-weight: 600;

            display: inline-block;

            text-transform: capitalize;

            color: #fff;

        }


        .testimonial-status-active {

            background: #16a34a;

        }


        .testimonial-status-hidden {

            background: #757575;

        }


        /* Actions */

        .testimonial-actions {

            display: flex;

            gap: 6px;

            justify-content: center;

            align-items: center;

            flex-wrap: wrap;

        }


        .testimonial-actions .btn-floating {

            margin: 0;

        }


        /* Row hover */

        tr.testimonial-row {

            cursor: pointer;

        }


        tr.testimonial-row:hover {

            background: #f5f5f5;

        }


        td.actions-column {

            cursor: default;

        }


        /* Add testimonial button */

        .testimonial-add-wrapper {

            display: flex;

            justify-content: flex-end;

            padding: 6px 0;

            margin-bottom: 5px;

        }


        /* Empty state */

        .testimonial-empty {

            text-align: center !important;

            padding: 30px !important;

        }


        .testimonial-empty i {

            display: block;

            font-size: 36px;

            color: #bdbdbd;

            margin-bottom: 8px;

        }


        .testimonial-empty span {

            color: #9e9e9e;

        }


        /* Pagination */

        .testimonial-pagination {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 5px;

            margin-top: 20px;

        }


        .testimonial-pagination a {

            min-width: 32px;

            height: 32px;

            line-height: 32px;

            text-align: center;

            border-radius: 3px;

            color: #555;

            text-decoration: none;

            border: 1px solid #ddd;

            font-size: 13px;

        }


        .testimonial-pagination a:hover {

            background: #f5f5f5;

        }


        .testimonial-pagination a.active {

            background: #26a69a;

            border-color: #26a69a;

            color: #fff;

        }


        /* Responsive */

        @media (max-width: 768px) {

            .testimonial-add-wrapper {

                justify-content: flex-start;

            }


            table {

                min-width: 900px;

            }

        }

    </style>

</head>


<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click"
    data-menu="vertical-dark-menu"
    data-col="2-columns"
>


    <!-- SIDEBAR -->

    <%- include('_layouts/sidenavbar') %>


    <!-- MAIN -->

    <div id="main">

        <div class="row">


            <!-- Breadcrumb Header -->

            <div
                class="pt-1 pb-0"
                id="breadcrumbs-wrapper"
            >

                <div class="container">

                    <div class="row">


                        <!-- Messages -->

                        <%- include('messages', { messages: messages }) %>


                        <!-- Page Title -->

                        <div class="col s12 m6 l6">

                            <h6 class="breadcrumbs-title">

                                Manage Testimonials

                            </h6>

                        </div>


                        <!-- Breadcrumbs -->

                        <div
                            class="col s12 m6 l6 right-align-md"
                            style="margin-top:-10px;"
                        >

                            <ol class="breadcrumbs mb-0">

                                <li class="breadcrumb-item">

                                    <a href="/admin/dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="breadcrumb-item active">

                                    Testimonials

                                </li>

                            </ol>

                        </div>

                    </div>


                    <!-- Add Testimonial -->

                    <div class="testimonial-add-wrapper">

                        <a
                            class="btn btn-add btn-breadcrumbs white-text"
                            href="/admin/testimonials/add"
                        >

                            + Add Testimonial

                        </a>

                    </div>


                    <!-- Card Header -->

                    <div class="row">

                        <div class="col s12 m6">

                            <h5 class="mt-0">

                                All Testimonials

                            </h5>


                            <p class="grey-text">

                                View and manage customer testimonials

                            </p>

                        </div>

                    </div>


                    <!-- Main Content -->

                    <div class="col s12">

                        <div class="container">

                            <div class="section section-data-tables">

                                <div class="row">

                                    <div class="col s12">


                                        <div class="card">

                                            <div class="card-content">


                                                <!-- Table -->

                                                <div class="row">

                                                    <div class="col s12 overflow">


                                                        <table
                                                            id="page-length-option"
                                                            class="display"
                                                        >

                                                            <thead>

                                                                <tr>

                                                                    <th>Sr</th>

                                                                    <th>Photo</th>

                                                                    <th>Name</th>

                                                                    <th>Rating</th>

                                                                    <th>Message</th>

                                                                    <th>Status</th>

                                                                    <th>Actions</th>

                                                                </tr>

                                                            </thead>


                                                            <tbody>


                                                                <% if (!testimonials || testimonials.length === 0) { %>


                                                                    <tr>

                                                                        <td
                                                                            colspan="7"
                                                                            class="testimonial-empty"
                                                                        >

                                                                            <i class="material-icons">

                                                                                rate_review

                                                                            </i>


                                                                            <span>

                                                                                No testimonials found

                                                                            </span>

                                                                        </td>

                                                                    </tr>


                                                                <% } else { %>


                                                                    <% testimonials.forEach((t, index) => { %>


                                                                        <tr
                                                                            class="testimonial-row"
                                                                            data-href="/admin/testimonials/edit/<%= t._id %>"
                                                                        >


                                                                            <!-- Sr -->

                                                                            <td>

                                                                                <%= index + 1 %>

                                                                            </td>


                                                                            <!-- Photo -->

                                                                            <td>

                                                                                <img
                                                                                    class="testimonial-table-image"
                                                                                    src="/uploads/testimonials/<%= t.image || '' %>"
                                                                                    onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2250%22 height=%2250%22%3E%3Ccircle cx=%2225%22 cy=%2225%22 r=%2225%22 fill=%22%23f0f0f0%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%23aaa%22 font-size=%228%22%3ENo Img%3C/text%3E%3C/svg%3E'"
                                                                                    alt="<%= t.name %>"
                                                                                >

                                                                            </td>


                                                                            <!-- Name -->

                                                                            <td>

                                                                                <span class="testimonial-name">

                                                                                    <%= t.name %>

                                                                                </span>


                                                                                <% if (t.designation) { %>

                                                                                    <span class="testimonial-designation">

                                                                                        <%= t.designation %>

                                                                                    </span>

                                                                                <% } %>

                                                                            </td>


                                                                            <!-- Rating -->

                                                                            <td>

                                                                                <span class="testimonial-rating">

                                                                                    ⭐ <%= t.rating %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- Message -->

                                                                            <td>

                                                                                <% if (t.message) { %>

                                                                                    <span
                                                                                        class="testimonial-message"
                                                                                        title="<%= t.message %>"
                                                                                    >

                                                                                        <%= t.message %>

                                                                                    </span>

                                                                                <% } else { %>

                                                                                    <span class="grey-text">

                                                                                        N/A

                                                                                    </span>

                                                                                <% } %>

                                                                            </td>


                                                                            <!-- Status -->

                                                                            <td>

                                                                                <span
                                                                                    class="testimonial-status
                                                                                    <%= t.isActive
                                                                                        ? 'testimonial-status-active'
                                                                                        : 'testimonial-status-hidden'
                                                                                    %>"
                                                                                >

                                                                                    <%= t.isActive
                                                                                        ? 'Active'
                                                                                        : 'Hidden'
                                                                                    %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- Actions -->

                                                                            <td class="actions-column">

                                                                                <div class="testimonial-actions">


                                                                                    <!-- Edit -->

                                                                                    <a
                                                                                        href="/admin/testimonials/edit/<%= t._id %>"
                                                                                        class="btn-floating waves-effect waves-light accent-2"
                                                                                        title="Edit"
                                                                                    >

                                                                                        <i class="material-icons">

                                                                                            edit

                                                                                        </i>

                                                                                    </a>


                                                                                    <!-- Delete -->

                                                                                    <a
                                                                                        href="#"
                                                                                        class="btn-floating waves-effect waves-light red btn-delete-testimonial"
                                                                                        data-id="<%= t._id %>"
                                                                                        data-name="<%= t.name %>"
                                                                                        title="Delete"
                                                                                    >

                                                                                        <i class="material-icons">

                                                                                            delete

                                                                                        </i>

                                                                                    </a>


                                                                                </div>

                                                                            </td>


                                                                        </tr>


                                                                    <% }) %>


                                                                <% } %>


                                                            </tbody>

                                                        </table>


                                                    </div>

                                                </div>


                                                <!-- Pagination -->

                                                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>


                                                    <div class="testimonial-pagination">


                                                        <% for (let i = 1; i <= totalPages; i++) { %>


                                                            <a
                                                                href="/admin/testimonials?page=<%= i %>"
                                                                class="<%= currentPage === i ? 'active' : '' %>"
                                                            >

                                                                <%= i %>

                                                            </a>


                                                        <% } %>


                                                    </div>


                                                <% } %>


                                            </div>

                                        </div>


                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                </div>

            </div>


        </div>

    </div>


    <!-- COMMON JS -->

    <%- include('_layouts/commonJs') %>


    <!-- DATATABLE JS -->

    <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>

    <script src="/app-assets/js/scripts/data-tables.js"></script>


    <script>

        document.addEventListener('DOMContentLoaded', function () {


            /*
             * Testimonial row click
             */

            document
                .querySelectorAll('.testimonial-row')
                .forEach(function (row) {


                    row.addEventListener('click', function (e) {


                        /*
                         * Do not redirect when
                         * clicking action buttons
                         */

                        if (

                            e.target.closest('.actions-column') ||

                            e.target.closest('a') ||

                            e.target.closest('button')

                        ) {

                            return;

                        }


                        const href =
                            row.getAttribute('data-href');


                        if (href) {

                            window.location.href = href;

                        }

                    });

                });


            /*
             * Delete Testimonial
             */

            document
                .querySelectorAll('.btn-delete-testimonial')
                .forEach(function (button) {


                    button.addEventListener('click', function (e) {

                        e.preventDefault();


                        const id =
                            this.dataset.id;


                        const name =
                            this.dataset.name;


                        if (!confirm(

                            'Delete testimonial "' +
                            name +
                            '"? This cannot be undone.'

                        )) {

                            return;

                        }


                        const form =
                            document.createElement('form');


                        form.method = 'POST';


                        form.action =
                            '/admin/testimonials/delete/' + id;


                        document.body.appendChild(form);


                        form.submit();

                    });

                });

        });

    </script>


</body>

</html>