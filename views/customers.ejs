<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>

  <%- include('_layouts/head') %>

  <title>Customers | <%= title %></title>


  <!-- DataTables CSS -->

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">

  <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">

  <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">


  <style>
    /* =========================================
           CUSTOMERS PAGE
           Same UI style as Orders page
        ========================================= */


    /* Table */

    table tr td,
    table tr th {

      text-align: center;

      vertical-align: middle !important;

      padding: 12px 10px !important;

    }


    /* Customer Name */

    .customer-name {

      font-weight: 600;

      color: #333;

      white-space: nowrap;

    }


    /* Customer Email */

    .customer-email {

      font-weight: 500;

      color: #424242;

    }


    /* Customer Phone */

    .customer-phone {

      color: #555;

      white-space: nowrap;

    }


    /* Joined Date */

    .customer-date {

      color: #666;

      font-size: 13px;

      white-space: nowrap;

    }


    /* Status */

    .customer-status {

      padding: 16px 12px;

      border-radius: 20px;

      font-size: 0.8rem;

      font-weight: 600;

      display: inline-block;

      text-transform: capitalize;

      color: #fff;

      white-space: nowrap;

    }


    /* Active */

    .customer-status-active {

      background: #16a34a;

    }


    /* Blocked */

    .customer-status-blocked {

      background: #dc2626;

    }


    /* Actions */

    .customer-actions {

      display: flex;

      gap: 6px;

      justify-content: center;

      align-items: center;

    }


    .customer-actions .btn {

      margin: 0;

    }


    /* Search */

    .customer-search-wrapper {

      display: flex;

      justify-content: flex-end;

      align-items: center;

      gap: 10px;

      margin-bottom: 10px;

    }


    .customer-search-wrapper form {

      display: flex;

      align-items: center;

      gap: 8px;

      margin: 0;

    }


    .customer-search-wrapper input {

      width: 220px;

      height: 38px;

      margin: 0;

      padding: 0 12px;

      border: 1px solid #ddd;

      border-radius: 4px;

      box-sizing: border-box;

      font-size: 13px;

      background: #fff;

    }


    .customer-search-wrapper input:focus {

      border-color: #26a69a;

      box-shadow: 0 0 0 1px #26a69a;

    }


    .customer-search-wrapper button {

      height: 38px;

      line-height: 38px;

      padding: 0 16px;

      border-radius: 4px;

      box-shadow: none;

      text-transform: none;

      font-weight: 600;

    }


    /* Empty State */

    .customer-empty {

      text-align: center !important;

      padding: 40px !important;

    }


    .customer-empty i {

      display: block;

      font-size: 40px;

      color: #bdbdbd;

      margin-bottom: 8px;

    }


    .customer-empty p {

      color: #9e9e9e;

      margin: 0;

    }


    /* Pagination */

    .customer-pagination {

      display: flex;

      justify-content: center;

      align-items: center;

      gap: 5px;

      margin-top: 20px;

    }


    .customer-pagination a {

      min-width: 32px;

      height: 32px;

      line-height: 32px;

      text-align: center;

      border-radius: 3px;

      color: #555;

      text-decoration: none;

      border: 1px solid #ddd;

      font-size: 13px;

    }


    .customer-pagination a:hover {

      background: #f5f5f5;

    }


    .customer-pagination a.active {

      background: #26a69a;

      border-color: #26a69a;

      color: #fff;

    }


    /* Responsive */

    @media (max-width: 768px) {

      .customer-search-wrapper {

        justify-content: flex-start;

        margin-top: 10px;

      }


      .customer-search-wrapper form {

        width: 100%;

      }


      .customer-search-wrapper input {

        width: 100%;

        flex: 1;

      }


      .customer-search-wrapper button {

        flex-shrink: 0;

      }


      table {

        min-width: 850px;

      }

    }
  </style>

</head>


<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns" data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">


  <!-- SIDEBAR -->

  <%- include('_layouts/sidenavbar') %>


  <!-- MAIN -->

  <div id="main">

    <div class="row">


      <!-- =========================================
                 PAGE HEADER
            ========================================== -->

      <div id="breadcrumbs-wrapper" class="customer-page-header">

        <div class="container">

          <div class="row">


            <!-- PAGE TITLE -->

            <!-- <div class="col s12 m6 l6">

                            <h6 class="breadcrumbs-title">

                                Manage Customers

                            </h6>

                        </div> -->


            <!-- BREADCRUMBS -->

            <!-- <div class="col s12 m6 l6 right-align-md" style="margin-top:-10px;">

              <ol class="breadcrumbs mb-0">

                <li class="breadcrumb-item">

                  <a href="/admin/dashboard">

                    Dashboard

                  </a>

                </li>


                <li class="breadcrumb-item active">

                  Customers

                </li>

              </ol>

            </div> -->

          </div>


          <!-- =====================================
                         DESCRIPTION + SEARCH
                    ====================================== -->

          <div class="row">


            <!-- DESCRIPTION -->

            <div class="col s12 m6">

              <h5 class="mt-0">

                All Customers

              </h5>


              <p class="grey-text">

                View and manage registered customers

              </p>

            </div>


            <!-- SEARCH -->

            <!-- <div class="col s12 m6">

              <div class="customer-search-wrapper">

                <form method="GET" action="/admin/users">

                  <input type="text" name="search" value="<%= search || '' %>" placeholder="Search name or email..." autocomplete="off">


                  <button type="submit" class="btn waves-effect waves-light">

                    Search

                  </button>

                </form>

              </div>

            </div> -->

                  <div class="col s12 m6 l6 right-align-md" style="margin-top:-10px;">

              <ol class="breadcrumbs mb-0">

                <li class="breadcrumb-item">

                  <a href="/admin/dashboard">

                    Dashboard

                  </a>

                </li>


                <li class="breadcrumb-item active">

                  Customers

                </li>

              </ol>

            </div>

          </div>

        </div>

      </div>


      <!-- =========================================
                 MESSAGES
            ========================================== -->

      <%- include('messages', { messages: messages }) %>


      <!-- =========================================
                 MAIN CONTENT
            ========================================== -->

      <div class="col s12">

        <div class="container">

          <div class="section section-data-tables">


            <div class="row">

              <div class="col s12">


                <div class="card">

                  <div class="card-content">


                    <!-- =================================
                                             TABLE
                                        ================================== -->

                    <div class="row">

                      <div class="col s12 overflow">


                        <table id="page-length-option" class="display">

                          <thead>

                            <tr>

                              <th>
                                Name
                              </th>

                              <th>
                                Email
                              </th>

                              <th>
                                Phone
                              </th>

                              <th>
                                Joined
                              </th>

                              <th>
                                Status
                              </th>

                              <th>
                                Actions
                              </th>

                            </tr>

                          </thead>


                          <tbody>


                            <% if (!users || users.length === 0) { %>


                            <!-- EMPTY STATE -->

                            <tr>

                              <td colspan="6" class="customer-empty">

                                <i class="material-icons">

                                  people_outline

                                </i>


                                <p>

                                  No customers found

                                </p>

                              </td>

                            </tr>


                            <% } else { %>


                            <% users.forEach(u => { %>


                            <tr>


                              <!-- =========================
                                                                         NAME
                                                                    ========================== -->

                              <td>

                                <span class="customer-name">

                                  <%= u.name || 'N/A' %>

                                </span>

                              </td>


                              <!-- =========================
                                                                         EMAIL
                                                                    ========================== -->

                              <td>

                                <span class="customer-email">

                                  <%= u.email || 'N/A' %>

                                </span>

                              </td>


                              <!-- =========================
                                                                         PHONE
                                                                    ========================== -->

                              <td>

                                <span class="customer-phone">

                                  <%= u.phone || '—' %>

                                </span>

                              </td>


                              <!-- =========================
                                                                         JOINED DATE
                                                                    ========================== -->

                              <td>

                                <span class="customer-date">

                                  <%= u.createdAt
                                                                                ? new Date(
                                                                                    u.createdAt
                                                                                ).toLocaleDateString('en-IN')
                                                                                : 'N/A'
                                                                            %>

                                </span>

                              </td>


                              <!-- =========================
                                                                         STATUS
                                                                    ========================== -->

                              <td>


                                <span class="customer-status
                                                                            <%= u.isBlocked
                                                                                ? 'customer-status-blocked'
                                                                                : 'customer-status-active'
                                                                            %>">

                                  <%= u.isBlocked
                                                                                ? 'Blocked'
                                                                                : 'Active'
                                                                            %>

                                </span>


                              </td>


                              <!-- =========================
                                                                         ACTIONS
                                                                    ========================== -->

                              <td>

                                <div class="customer-actions">


                                  <form method="POST" action="/admin/users/<%= u._id %>/toggle-block" data-confirm="<%= u.isBlocked ? 'Unblock' : 'Block' %> this user?">


                                    <button type="submit" class="btn waves-effect waves-light
                                                                                    <%= u.isBlocked
                                                                                        ? 'green'
                                                                                        : 'red'
                                                                                    %>" title="<%= u.isBlocked ? 'Unblock Customer' : 'Block Customer' %>">

                                      <%= u.isBlocked
                                                                                        ? 'Unblock'
                                                                                        : 'Block'
                                                                                    %>

                                    </button>


                                  </form>


                                </div>

                              </td>


                            </tr>


                            <% }) %>


                            <% } %>


                          </tbody>

                        </table>


                      </div>

                    </div>


                    <!-- =================================
                                             PAGINATION
                                        ================================== -->

                    <% if (
                                            typeof totalPages !== 'undefined' &&
                                            totalPages > 1
                                        ) { %>


                    <div class="customer-pagination">


                      <% for (
                                                    let i = 1;
                                                    i <= totalPages;
                                                    i++
                                                ) { %>


                      <a href="/admin/users?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>" class="<%= currentPage === i ? 'active' : '' %>">

                        <%= i %>

                      </a>


                      <% } %>


                    </div>


                    <% } %>


                  </div>

                </div>


              </div>

            </div>


          </div>

        </div>

      </div>


    </div>

  </div>


  <!-- =========================================
         COMMON JS
    ========================================== -->

  <%- include('_layouts/commonJs') %>


  <!-- =========================================
         DATATABLE JS
    ========================================== -->

  <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>

  <script src="/app-assets/js/scripts/data-tables.js"></script>


  <!-- =========================================
         CONFIRMATION
    ========================================== -->

  <script>
    document.addEventListener('DOMContentLoaded', function() {

      const forms = document.querySelectorAll(
        'form[data-confirm]'
      );


      forms.forEach(function(form) {

        form.addEventListener('submit', function(event) {

          const message =
            form.getAttribute('data-confirm');


          if (message) {

            const confirmed =
              window.confirm(message);


            if (!confirmed) {

              event.preventDefault();

            }

          }

        });

      });

    });
  </script>


</body>

</html>