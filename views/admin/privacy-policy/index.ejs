<div class="gt-card">

    <div class="gt-card-header">
        <h3>Privacy Policy</h3>
        <p>Update the privacy policy shown on the website.</p>
    </div>

    <div class="gt-card-body">

        <form method="POST" action="/admin/privacy-policy">

            <div class="mb-3">

                <label class="form-label">
                    Privacy Policy
                </label>

                <textarea
                    id="editor"
                    name="content"
                ><%= policy.content || "" %></textarea>

            </div>

            <button
                class="btn btn-primary"
                type="submit"
            >
                Save Changes
            </button>

        </form>

    </div>

</div>

<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

<script>

ClassicEditor
.create(document.querySelector('#editor'))
.catch(error=>console.error(error));

</script>