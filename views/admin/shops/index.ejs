<div class="gt-card">

    <div class="gt-card-header">
        <h3>Gift Shops</h3>
        <p>Manage Gift Shops</p>
    </div>

    <div class="gt-card-body">

        <form
            action="/admin/shops"
            method="POST"
            enctype="multipart/form-data"
        >

            <!-- ========================= -->
            <!-- Shop Details -->
            <!-- ========================= -->

            <h4 class="mb-3">Shop Details</h4>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Shop Name
                    </label>

                    <input
                        type="text"
                        name="shopName"
                        class="form-control"
                        required
                    >

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Location
                    </label>

                    <input
                        type="text"
                        name="location"
                        class="form-control"
                        required
                    >

                </div>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                ></textarea>

            </div>

            <hr>

            <!-- ========================= -->
            <!-- Opening -->
            <!-- ========================= -->

            <h4 class="mb-3">
                Opening Details
            </h4>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label>
                        Open Days
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        name="openDays"
                        placeholder="Open 7 Days A Week"
                    >

                </div>

                <div class="col-md-6 mb-3">

                    <label>
                        Opening Time
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        name="openingTime"
                        placeholder="11:00 AM - 9:00 PM"
                    >

                </div>

            </div>

            <div class="mb-4">

                <label>
                    Address
                </label>

                <textarea
                    class="form-control"
                    rows="3"
                    name="address"
                ></textarea>

            </div>

            <hr>

            <!-- ========================= -->
            <!-- Contact -->
            <!-- ========================= -->

            <h4 class="mb-3">
                Contact Details
            </h4>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label>
                        Phone Number 1
                    </label>

                    <input
                        class="form-control"
                        name="phone1"
                    >

                </div>

                <div class="col-md-6 mb-3">

                    <label>
                        Phone Number 2
                    </label>

                    <input
                        class="form-control"
                        name="phone2"
                    >

                </div>

            </div>

            <hr>

            <!-- ========================= -->
            <!-- Personal Shopper -->
            <!-- ========================= -->

            <h4 class="mb-3">
                Personal Shopper
            </h4>

            <div class="row">

                <div class="col-md-4 mb-3">

                    <label>
                        Personal Shopper 1
                    </label>

                    <input
                        class="form-control"
                        name="personalShopper1"
                    >

                </div>

                <div class="col-md-4 mb-3">

                    <label>
                        Personal Shopper 2
                    </label>

                    <input
                        class="form-control"
                        name="personalShopper2"
                    >

                </div>

                <div class="col-md-4 mb-3">

                    <label>
                        Personal Shopper 3
                    </label>

                    <input
                        class="form-control"
                        name="personalShopper3"
                    >

                </div>

            </div>

            <hr>

            <!-- ========================= -->
            <!-- Images -->
            <!-- ========================= -->

            <h4 class="mb-3">
                Shop Images
            </h4>

            <div class="mb-4">

                <label>
                    Upload Multiple Images
                </label>

                <input
                    type="file"
                    name="images"
                    multiple
                    accept="image/*"
                    class="form-control"
                    required
                >

                <small class="text-muted">

                    Select multiple shop images.

                </small>

            </div>

            <div class="row">

                <div class="col-md-4 mb-4">

                    <label>
                        Display Order
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        name="displayOrder"
                        value="0"
                    >

                </div>

            </div>

            <button
                class="btn btn-primary"
                type="submit"
            >
                Save Shop
            </button>

        </form>

    </div>

</div>

<hr>

<h3 class="mb-4">

    Added Shops

</h3>

<div class="row">

    <% shops.forEach(shop=>{ %>

    <div class="col-lg-6 mb-4">

        <div
            class="card"
            style="border-radius:12px;"
        >

            <div class="card-body">

                <h4>

                    <%= shop.shopName %>

                </h4>

                <p>

                    <strong>Location :</strong>

                    <%= shop.location %>

                </p>

                <p>

                    <strong>Open Days :</strong>

                    <%= shop.openDays %>

                </p>

                <p>

                    <strong>Opening Time :</strong>

                    <%= shop.openingTime %>

                </p>

                <p>

                    <strong>Address :</strong>

                    <%= shop.address %>

                </p>

                <p>

                    <strong>Phone 1 :</strong>

                    <%= shop.phone1 %>

                </p>

                <p>

                    <strong>Phone 2 :</strong>

                    <%= shop.phone2 %>

                </p>

                <p>

                    <strong>Personal Shopper :</strong>

                    <%= shop.personalShopper1 %>,
                    <%= shop.personalShopper2 %>,
                    <%= shop.personalShopper3 %>

                </p>

                <div class="row">

                    <% shop.images.forEach(image=>{ %>

                    <div class="col-md-4 mb-3">

                        <img
                            src="<%= image %>"
                            class="img-fluid"
                            style="
                                height:160px;
                                width:100%;
                                object-fit:cover;
                                border-radius:8px;
                                border:1px solid #ddd;
                            "
                        >

                    </div>

                    <% }) %>

                </div>

                <form
                    action="/admin/shops/delete/<%= shop._id %>"
                    method="POST"
                >

                    <button
                        class="btn btn-danger"
                    >
                        Delete
                    </button>

                </form>

            </div>

        </div>

    </div>

    <% }) %>

</div>

<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

<script>

ClassicEditor.create(
document.querySelector("#description")
);

</script>