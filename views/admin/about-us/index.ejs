<div class="gt-card">

    <div class="gt-card-header">
        <h3>About Us</h3>
        <p>Manage About Us page content.</p>
    </div>

    <div class="gt-card-body">

        <form
            action="/admin/about-us"
            method="POST"
            enctype="multipart/form-data"
        >

            <!-- ========================= -->
            <!-- Intro -->
            <!-- ========================= -->

            <h4 class="mb-3">Intro Section</h4>

            <div class="mb-4">

                <label class="form-label">
                    Intro Description
                </label>

                <textarea
                    id="introEditor"
                    name="introDescription"
                ><%= about.introDescription %></textarea>

            </div>

            <hr>

            <!-- ========================= -->
            <!-- Brand Story -->
            <!-- ========================= -->

            <h4 class="mb-3">Brand Story</h4>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label>Heading</label>

                    <input
                        type="text"
                        name="brandHeading"
                        class="form-control"
                        value="<%= about.brandHeading %>"
                    >

                </div>

                <div class="col-md-6 mb-3">

                    <label>Sub Heading</label>

                    <input
                        type="text"
                        name="brandSubHeading"
                        class="form-control"
                        value="<%= about.brandSubHeading %>"
                    >

                </div>

            </div>

            <div class="mb-3">

                <label>Description</label>

                <textarea
                    id="brandEditor"
                    name="brandDescription"
                ><%= about.brandDescription %></textarea>

            </div>

            <div class="mb-4">

                <label>Brand Image</label>

                <input
                    type="file"
                    name="brandImage"
                    class="form-control"
                >

                <% if(about.brandImage){ %>

<div style="margin-top:15px">

    <img
        src="<%= about.brandImage %>"
        style="
            width:180px;
            height:180px;
            object-fit:cover;
            border-radius:10px;
            border:1px solid #ddd;
        "
    >

</div>

<% } %>

            </div>

            <hr>

            <!-- ========================= -->
            <!-- Studio -->
            <!-- ========================= -->

            <h4 class="mb-3">Our Studio</h4>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label>Heading</label>

                    <input
                        class="form-control"
                        name="studioHeading"
                        value="<%= about.studioHeading %>"
                    >

                </div>

                <div class="col-md-6 mb-3">

                    <label>Sub Heading</label>

                    <input
                        class="form-control"
                        name="studioSubHeading"
                        value="<%= about.studioSubHeading %>"
                    >

                </div>

            </div>

            <div class="mb-3">

                <label>Description</label>

                <textarea
                    id="studioEditor"
                    name="studioDescription"
                ><%= about.studioDescription %></textarea>

            </div>

            <div class="row">

                <div class="col-md-4">

                    <label>Studio Image 1</label>

                    <input
                        type="file"
                        class="form-control"
                        name="studioImage1"
                    >

                    <% if(about.studioImage1){ %>

<img
    src="<%= about.studioImage1 %>"
    width="150"
    style="margin-top:10px;border-radius:8px;"
>

<% } %>

                </div>

                <div class="col-md-4">

                    <label>Studio Image 2</label>

                    <input
                        type="file"
                        class="form-control"
                        name="studioImage2"
                    >

                    <% if(about.studioImage2){ %>

<img
    src="<%= about.studioImage2 %>"
    width="150"
    style="margin-top:10px;border-radius:8px;"
>

<% } %>

                </div>

                <div class="col-md-4">

                    <label>Studio Image 3</label>

                    <input
                        type="file"
                        class="form-control"
                        name="studioImage3"
                    >

                    <% if(about.studioImage3){ %>

<img
    src="<%= about.studioImage3 %>"
    width="150"
    style="margin-top:10px;border-radius:8px;"
>

<% } %>
                </div>

            </div>

            <hr class="my-4">

            <!-- ========================= -->
            <!-- Journey -->
            <!-- ========================= -->

            <h4>Gifttory Journey</h4>

            <div class="mb-3">

                <label>Journey Heading</label>

                <input
                    class="form-control"
                    name="journeyHeading"
                    value="<%= about.journeyHeading %>"
                >

            </div>

            <% for(let i=0;i<4;i++){ %>

            <div
                style="border:1px solid #ddd;padding:20px;margin-bottom:20px;border-radius:8px;"
            >

                <h5>Journey Card <%= i+1 %></h5>

                <label>Icon</label>

                <input
                    type="file"
                    class="form-control mb-3"
                    name="journeyIcon<%= i %>"
                >

                <% if(about.journey[i]?.icon){ %>

<img
    src="<%= about.journey[i].icon %>"
    width="70"
    style="
        margin-bottom:20px;
        border-radius:8px;
    "
>

<% } %>
                <label>Title</label>

                <input
                    class="form-control mb-3"
                    name="journeyTitle<%= i %>"
                    value="<%= about.journey[i]?.title %>"
                >

                <label>Description</label>

                <textarea
                    class="form-control"
                    rows="4"
                    name="journeyDescription<%= i %>"
                ><%= about.journey[i]?.description %></textarea>

            </div>

            <% } %>

            <button
                class="btn btn-primary"
                type="submit"
            >
                Save About Us
            </button>

        </form>

    </div>

</div>

<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

<script>

ClassicEditor.create(document.querySelector('#introEditor'));

ClassicEditor.create(document.querySelector('#brandEditor'));

ClassicEditor.create(document.querySelector('#studioEditor'));

</script>