<div class="gt-stat-grid">
  <div class="gt-stat-card bg-rose">
    <div class="gt-stat-icon">👥</div>
    <div class="gt-stat-label">Total Customers</div>
    <div class="gt-stat-value"><%= stats.totalUsers %></div>
  </div>
  <div class="gt-stat-card bg-gold">
    <div class="gt-stat-icon">🎁</div>
    <div class="gt-stat-label">Total Products</div>
    <div class="gt-stat-value"><%= stats.totalProducts %></div>
  </div>
  <div class="gt-stat-card bg-info">
    <div class="gt-stat-icon">📦</div>
    <div class="gt-stat-label">Total Orders</div>
    <div class="gt-stat-value"><%= stats.totalOrders %></div>
  </div>
  <div class="gt-stat-card bg-success">
    <div class="gt-stat-icon">💰</div>
    <div class="gt-stat-label">Revenue (Paid)</div>
    <div class="gt-stat-value">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></div>
  </div>
</div>

<div class="gt-stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); margin-bottom: 24px;">
  <div class="gt-stat-card">
    <div class="gt-stat-label">New Contact Enquiries</div>
    <div class="gt-stat-value"><%= stats.pendingContacts %></div>
    <a href="/admin/enquiries/contact" class="gt-btn gt-btn-outline gt-btn-sm" style="margin-top:12px;">View all</a>
  </div>
  <div class="gt-stat-card">
    <div class="gt-stat-label">New Bulk Order Enquiries</div>
    <div class="gt-stat-value"><%= stats.pendingBulkOrders %></div>
    <a href="/admin/enquiries/bulk-order" class="gt-btn gt-btn-outline gt-btn-sm" style="margin-top:12px;">View all</a>
  </div>
  <div class="gt-stat-card">
    <div class="gt-stat-label">Total Categories</div>
    <div class="gt-stat-value"><%= stats.totalCategories %></div>
    <a href="/admin/categories" class="gt-btn gt-btn-outline gt-btn-sm" style="margin-top:12px;">Manage</a>
  </div>
</div>

<div class="gt-form-grid" style="align-items:start;">
  <div class="gt-card">
    <div class="gt-card-header">
      <h2>Recent Orders</h2>
      <a href="/admin/orders" class="gt-btn gt-btn-outline gt-btn-sm">View all</a>
    </div>
    <div class="gt-table-wrap">
      <table class="gt-table">
        <thead>
          <tr><th>Order #</th><th>Customer</th><th>Amount</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% if (stats.recentOrders.length === 0) { %>
            <tr><td colspan="4" class="gt-text-muted">No orders yet</td></tr>
          <% } %>
          <% stats.recentOrders.forEach(order => { %>
            <tr>
              <td><a href="/admin/orders/<%= order._id %>"><%= order.orderNumber %></a></td>
              <td><%= order.user ? order.user.name : 'Deleted user' %></td>
              <td>₹<%= order.totalPrice %></td>
              <td>
                <span class="gt-pill gt-pill-<%= order.orderStatus === 'delivered' ? 'success' : order.orderStatus === 'cancelled' ? 'danger' : 'info' %>">
                  <%= order.orderStatus.replace('_',' ') %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="gt-card">
    <div class="gt-card-header">
      <h2>Low Stock Products</h2>
      <a href="/admin/products" class="gt-btn gt-btn-outline gt-btn-sm">Manage</a>
    </div>
    <div class="gt-card-body">
      <% if (stats.lowStockProducts.length === 0) { %>
        <p class="gt-text-muted gt-mb-0">All products are well stocked 🎉</p>
      <% } %>
      <% stats.lowStockProducts.forEach(p => { %>
        <div class="gt-flex-between" style="padding: 8px 0; border-bottom: 1px solid var(--gt-border);">
          <span><%= p.name %></span>
          <span class="gt-pill gt-pill-warning"><%= p.stock %> left</span>
        </div>
      <% }) %>
    </div>
  </div>
</div>
