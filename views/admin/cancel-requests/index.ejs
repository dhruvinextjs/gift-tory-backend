<div class="gt-card">

    <div class="gt-card-header d-flex justify-content-between align-items-center">

        <div>
            <h3>Cancel Requests</h3>
            <p>Manage customer cancellation requests.</p>
        </div>

        <form method="GET" action="/admin/cancel-requests">

            <select
                name="status"
                class="form-select"
                onchange="this.form.submit()"
            >

                <option value="">All Status</option>

                <option value="pending" <%= status==="pending" ? "selected" : "" %>>
                    Pending
                </option>

                <option value="approved" <%= status==="approved" ? "selected" : "" %>>
                    Approved
                </option>

                <option value="rejected" <%= status==="rejected" ? "selected" : "" %>>
                    Rejected
                </option>

            </select>

        </form>

    </div>

    <div class="gt-card-body">

        <table class="table table-bordered table-hover">

            <thead>

                <tr>

                    <th>#</th>

                    <th>Order No</th>

                    <th>Customer</th>

                    <th>Reason</th>

                    <th>Status</th>

                    <th>Date</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                <% if(requests.length===0){ %>

                    <tr>

                        <td colspan="7" class="text-center">

                            No Cancel Requests Found

                        </td>

                    </tr>

                <% } %>

                <% requests.forEach(function(item,index){ %>

                    <tr>

                        <td>

                            <%= (currentPage-1)*10 + index + 1 %>

                        </td>

                        <td>

                            <%= item.order?.orderNumber || "-" %>

                        </td>

                        <td>

                            <%= item.user?.name || "Guest User" %>

                        </td>

                        <td>

                            <%= item.reason %>

                        </td>

                        <td>

                            <% if(item.status==="pending"){ %>

                                <span class="badge bg-warning">

                                    Pending

                                </span>

                            <% } %>

                            <% if(item.status==="approved"){ %>

                                <span class="badge bg-success">

                                    Approved

                                </span>

                            <% } %>

                            <% if(item.status==="rejected"){ %>

                                <span class="badge bg-danger">

                                    Rejected

                                </span>

                            <% } %>

                        </td>

                        <td>

                            <%= new Date(item.createdAt).toLocaleDateString() %>

                        </td>

                        <td>

                            <a
                                href="/admin/cancel-requests/<%= item._id %>"
                                class="btn btn-primary btn-sm"
                            >

                                View

                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

<% if(totalPages>1){ %>

<nav class="mt-4">

    <ul class="pagination justify-content-center">

        <% for(let i=1;i<=totalPages;i++){ %>

            <li class="page-item <%= currentPage===i ? "active" : "" %>">

                <a
                    class="page-link"
                    href="/admin/cancel-requests?page=<%= i %>&status=<%= status %>"
                >

                    <%= i %>

                </a>

            </li>

        <% } %>

    </ul>

</nav>

<% } %>