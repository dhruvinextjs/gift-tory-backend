<div class="gt-card">

    <div class="gt-card-header">

        <div>
            <h2>Cancel Requests</h2>
            <p class="gt-text-muted">
                Manage customer cancellation requests.
            </p>
        </div>

        <form method="GET" action="/admin/cancel-requests">

            <select
                name="status"
                class="gt-select"
                onchange="this.form.submit()">

                <option value="">All Status</option>

                <option value="pending" <%= status==="pending" ? "selected" : "" %>>
                    Pending
                </option>

                <option value="approved" <%= status==="approved" ? "selected" : "" %>>
                    Approved
                </option>

                <option value="rejected" <%= status==="rejected" ? "selected" : "" %>>
                    Rejected
                </option>

            </select>

        </form>

    </div>

    <div class="gt-table-wrap">

        <table class="gt-table">

            <thead>

                <tr>

                    <th>#</th>
                    <th>Order No.</th>
                    <th>Customer</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% if(requests.length===0){ %>

                    <tr>

                        <td colspan="7" class="gt-text-muted">

                            No cancel requests found.

                        </td>

                    </tr>

                <% } %>

                <% requests.forEach(function(item,index){ %>

                    <tr>

                        <td>
                            <%= (currentPage-1)*10 + index + 1 %>
                        </td>

                        <td>
                            <strong>
                                <%= item.order?.orderNumber || "-" %>
                            </strong>
                        </td>

                        <td>
                            <%= item.user?.name || "Guest User" %>
                        </td>

                        <td>
                            <%= item.reason %>
                        </td>

                        <td>

                            <% if(item.status==="pending"){ %>

                                <span class="gt-pill gt-pill-warning">
                                    Pending
                                </span>

                            <% } %>

                            <% if(item.status==="approved"){ %>

                                <span class="gt-pill gt-pill-success">
                                    Approved
                                </span>

                            <% } %>

                            <% if(item.status==="rejected"){ %>

                                <span class="gt-pill gt-pill-danger">
                                    Rejected
                                </span>

                            <% } %>

                        </td>

                        <td>

                            <%= new Date(item.createdAt).toLocaleDateString() %>

                        </td>

                        <td>

                            <a
                                href="/admin/cancel-requests/<%= item._id %>"
                                class="gt-btn gt-btn-outline gt-btn-sm">

                                View

                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <% if(totalPages>1){ %>

        <div class="gt-pagination" style="padding:20px;">

            <% for(let i=1;i<=totalPages;i++){ %>

                <a
                    href="/admin/cancel-requests?page=<%= i %>&status=<%= status %>"
                    class="<%= currentPage===i ? 'active' : '' %>">

                    <%= i %>

                </a>

            <% } %>

        </div>

    <% } %>

</div>