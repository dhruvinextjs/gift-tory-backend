<div class="gt-page-header">
  <div>
    <h1 class="gt-page-title">Products</h1>
    <p class="gt-page-subtitle">Manage all your products</p>
  </div>
  <a href="/admin/products/add" class="gt-btn gt-btn-primary">
    <i class="material-icons">add</i>
    Add Product
  </a>
</div>

<div class="gt-card">
  <div class="gt-card-header gt-card-header-actions">
    <h2>All Products</h2>
    <form method="GET" action="/admin/products" class="gt-search-form">
      <div class="gt-search-wrap">
        <i class="material-icons">search</i>
        <input class="gt-input gt-input-search" type="text" name="search" value="<%= search %>" placeholder="Search products..." />
      </div>
      <button class="gt-btn gt-btn-outline gt-btn-sm" type="submit">Search</button>
    </form>
  </div>

  <div class="gt-table-wrap">
    <table class="gt-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr>
            <td colspan="7">
              <div class="gt-empty-state">
                <i class="material-icons">inventory_2</i>
                <p>No products found</p>
              </div>
            </td>
          </tr>
        <% } %>

        <% products.forEach(p => { %>
          <tr>
            <td>
              <img
                class="gt-table-thumb"
                src="/uploads/products/<%= p.images[0] %>"
                onerror="this.src='https://via.placeholder.com/44'"
                alt="<%= p.name %>"
              />
            </td>
            <td>
              <span class="gt-table-name"><%= p.name %></span>
            </td>
            <td><%= p.category ? p.category.name : '—' %></td>
            <td>
              <span class="gt-price">₹<%= p.discountPrice || p.price %></span>
              <% if (p.discountPrice) { %>
                <span class="gt-price-old">₹<%= p.price %></span>
              <% } %>
            </td>
            <td>
              <% if (p.stock <= 5) { %>
                <span class="gt-pill gt-pill-warning"><%= p.stock %></span>
              <% } else { %>
                <%= p.stock %>
              <% } %>
            </td>
            <td>
              <span class="gt-pill <%= p.isActive ? 'gt-pill-success' : 'gt-pill-gray' %>">
                <%= p.isActive ? 'Active' : 'Hidden' %>
              </span>
            </td>
            <td>
              <div class="gt-actions">
                <a class="gt-btn gt-btn-outline gt-btn-sm" href="/admin/products/edit/<%= p._id %>">
                  Edit
                </a>
                <form class="gt-inline-form" method="POST" action="/admin/products/delete/<%= p._id %>" data-confirm="Delete this product permanently?">
                  <button class="gt-btn gt-btn-danger gt-btn-sm" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <div class="gt-pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a
          href="/admin/products?page=<%= i %>&search=<%= search %>"
          class="gt-page-link <%= currentPage === i ? 'active' : '' %>"
        >
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>
</div>