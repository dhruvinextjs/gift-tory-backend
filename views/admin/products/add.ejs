<div class="gt-page-header">
  <div>
    <h1 class="gt-page-title">Add Product</h1>
    <p class="gt-page-subtitle">Create a new product</p>
  </div>
  <a href="/admin/products" class="gt-btn gt-btn-outline">
    <i class="material-icons">arrow_back</i>
    Back
  </a>
</div>

<div class="gt-card">
  <div class="gt-card-body gt-form-body">
    <form method="POST" action="/admin/products/add" enctype="multipart/form-data">

      <!-- BASIC -->
      <div class="gt-form-section">
        <div class="gt-form-section-head">Basic Info</div>

        <div class="gt-form-row">
          <div class="gt-form-group">
            <label>Product Name *</label>
            <input class="gt-input" type="text" name="name" required />
          </div>
          <div class="gt-form-group">
            <label>SKU</label>
            <input class="gt-input" type="text" name="sku" placeholder="Optional" />
          </div>
        </div>

        <div class="gt-form-group">
          <label>Short Description</label>
          <input class="gt-input" type="text" name="shortDescription" placeholder="One line summary" />
        </div>

        <div class="gt-form-group">
          <label>Full Description *</label>
          <textarea class="gt-input gt-textarea" name="description" rows="3" required></textarea>
        </div>
      </div>

      <!-- PRICING -->
      <div class="gt-form-section">
        <div class="gt-form-section-head">Pricing & Stock</div>

        <div class="gt-form-row gt-form-row-3">
          <div class="gt-form-group">
            <label>MRP (₹) *</label>
            <input class="gt-input" type="number" step="0.01" name="price" required />
          </div>
          <div class="gt-form-group">
            <label>Selling Price (₹)</label>
            <input class="gt-input" type="number" step="0.01" name="discountPrice" />
          </div>
          <div class="gt-form-group">
            <label>Stock *</label>
            <input class="gt-input" type="number" name="stock" required />
          </div>
        </div>
      </div>

      <!-- CATEGORY -->
      <div class="gt-form-section">
        <div class="gt-form-section-head">Category & Tags</div>

        <div class="gt-form-row">
          <div class="gt-form-group">
            <label>Category *</label>
            <select class="gt-select" name="category" required>
              <option value="">Select category</option>
              <% categories.forEach(c => { %>
                <option value="<%= c._id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="gt-form-group">
            <label>Occasions</label>
            <select class="gt-select" name="occasion" multiple size="3">
              <% occasions.forEach(o => { %>
                <option value="<%= o._id %>"><%= o.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="gt-form-group">
          <label>Tags</label>
          <input class="gt-input" type="text" name="tags" placeholder="birthday, personalized, mug" />
        </div>
      </div>

      <!-- IMAGES -->
      <div class="gt-form-section">
        <div class="gt-form-section-head">Images</div>

        <div class="gt-form-group">
          <label>Product Images * <span class="gt-optional">up to 6</span></label>
          <input class="gt-input" type="file" name="images" accept="image/*" multiple data-preview-input="imgPreview" required />
          <div class="gt-image-preview" id="imgPreview"></div>
        </div>
      </div>

      <!-- FLAGS -->
      <div class="gt-form-section">
        <div class="gt-form-section-head">Flags</div>
        <div class="gt-checkbox-grid">
          <label class="gt-checkbox-row"><input type="checkbox" name="isTrending" /> Trending</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isFeatured" /> Featured</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isBestSeller" /> Best Seller</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isNewArrival" /> New Arrival</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isPersonalized" /> Personalized</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isCorporateGift" /> Corporate Gift</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isSameDayDelivery" /> Same Day Delivery</label>
        </div>
      </div>

      <div class="gt-form-actions">
        <button type="submit" class="gt-btn gt-btn-primary">Save Product</button>
        <a href="/admin/products" class="gt-btn gt-btn-outline">Cancel</a>
      </div>

    </form>
  </div>
</div>