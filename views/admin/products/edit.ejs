<div class="gt-card">
  <div class="gt-card-header">
    <h2>Edit Product</h2>
    <a href="/admin/products" class="gt-btn gt-btn-outline">← Back to list</a>
  </div>
  <div class="gt-card-body">
    <form method="POST" action="/admin/products/edit/<%= product._id %>" enctype="multipart/form-data">
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Product Name *</label>
          <input class="gt-input" type="text" name="name" value="<%= product.name %>" required />
        </div>
        <div class="gt-form-group">
          <label>SKU (optional)</label>
          <input class="gt-input" type="text" name="sku" value="<%= product.sku || '' %>" />
        </div>
      </div>

      <div class="gt-form-group">
        <label>Short Description</label>
        <input class="gt-input" type="text" name="shortDescription" value="<%= product.shortDescription || '' %>" />
      </div>

      <div class="gt-form-group">
        <label>Full Description *</label>
        <textarea class="gt-input" name="description" rows="4" required><%= product.description %></textarea>
      </div>

      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>MRP Price (₹) *</label>
          <input class="gt-input" type="number" step="0.01" name="price" value="<%= product.price %>" required />
        </div>
        <div class="gt-form-group">
          <label>Discount / Selling Price (₹)</label>
          <input class="gt-input" type="number" step="0.01" name="discountPrice" value="<%= product.discountPrice || '' %>" />
        </div>
        <div class="gt-form-group">
          <label>Stock Quantity *</label>
          <input class="gt-input" type="number" name="stock" value="<%= product.stock %>" required />
        </div>
      </div>

      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Category *</label>
          <select class="gt-select" name="category" required>
            <% categories.forEach(c => { %>
              <option value="<%= c._id %>" <%= String(product.category) === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="gt-form-group">
          <label>Occasion(s)</label>
          <select class="gt-select" name="occasion" multiple size="4">
            <% occasions.forEach(o => { %>
              <option value="<%= o._id %>" <%= product.occasion.map(String).includes(String(o._id)) ? 'selected' : '' %>><%= o.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="gt-form-group">
        <label>Tags (comma separated)</label>
        <input class="gt-input" type="text" name="tags" value="<%= product.tags.join(', ') %>" />
      </div>

      <div class="gt-form-group">
        <label>Current Images</label>
        <div class="gt-image-preview">
          <% product.images.forEach(img => { %>
            <img src="/uploads/products/<%= img %>" alt="" />
          <% }) %>
        </div>
        <div class="gt-hint">Uploading new images below will replace all existing images.</div>
      </div>

      <div class="gt-form-group">
        <label>Replace Images (optional, up to 6)</label>
        <input class="gt-input" type="file" name="images" accept="image/*" multiple data-preview-input="imgPreview" />
        <div class="gt-image-preview" id="imgPreview"></div>
      </div>

      <div class="gt-form-group">
        <label>Product Flags</label>
        <div class="gt-checkbox-grid">
          <label class="gt-checkbox-row"><input type="checkbox" name="isTrending" <%= product.isTrending ? 'checked' : '' %> /> Trending</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isFeatured" <%= product.isFeatured ? 'checked' : '' %> /> Featured</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isBestSeller" <%= product.isBestSeller ? 'checked' : '' %> /> Best Seller</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isNewArrival" <%= product.isNewArrival ? 'checked' : '' %> /> New Arrival</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isPersonalized" <%= product.isPersonalized ? 'checked' : '' %> /> Personalized</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isCorporateGift" <%= product.isCorporateGift ? 'checked' : '' %> /> Corporate Gift</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isSameDayDelivery" <%= product.isSameDayDelivery ? 'checked' : '' %> /> Same Day Delivery</label>
          <label class="gt-checkbox-row"><input type="checkbox" name="isActive" <%= product.isActive ? 'checked' : '' %> /> Active (visible on site)</label>
        </div>
      </div>

      <button type="submit" class="gt-btn gt-btn-primary">Update Product</button>
    </form>
  </div>
</div>
