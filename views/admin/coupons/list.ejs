<div class="gt-card">
  <div class="gt-card-header">
    <h2>Coupons</h2>
    <a href="/admin/coupons/add" class="gt-btn gt-btn-primary">+ Add Coupon</a>
  </div>
  <div class="gt-table-wrap">
    <table class="gt-table">
      <thead><tr><th>Code</th><th>Discount</th><th>Min Order</th><th>Expiry</th><th>Usage</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (coupons.length === 0) { %>
          <tr><td colspan="7" class="gt-text-muted">No coupons yet.</td></tr>
        <% } %>
        <% coupons.forEach(c => { %>
          <tr>
            <td><strong><%= c.code %></strong></td>
            <td><%= c.discountType === 'percentage' ? c.discountValue + '%' : '₹' + c.discountValue %></td>
            <td>₹<%= c.minOrderAmount %></td>
            <td><%= new Date(c.expiryDate).toLocaleDateString('en-IN') %></td>
            <td><%= c.usedCount %> / <%= c.usageLimit %></td>
            <td><span class="gt-pill <%= c.isActive ? 'gt-pill-success' : 'gt-pill-gray' %>"><%= c.isActive ? 'Active' : 'Disabled' %></span></td>
            <td style="white-space:nowrap;">
              <form class="gt-inline-form" method="POST" action="/admin/coupons/<%= c._id %>/toggle-active">
                <button class="gt-btn gt-btn-outline gt-btn-sm" type="submit"><%= c.isActive ? 'Disable' : 'Enable' %></button>
              </form>
              <form class="gt-inline-form" method="POST" action="/admin/coupons/delete/<%= c._id %>" data-confirm="Delete this coupon?">
                <button class="gt-btn gt-btn-danger gt-btn-sm" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
