<div class="gt-card">
  <div class="gt-card-header">
    <h2>Customers</h2>
    <form method="GET" action="/admin/users" style="display:flex; gap:8px;">
      <input class="gt-input" type="text" name="search" value="<%= search %>" placeholder="Search name or email..." />
      <button class="gt-btn gt-btn-outline" type="submit">Search</button>
    </form>
  </div>

  <div class="gt-table-wrap">
    <table class="gt-table">
      <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Joined</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="6" class="gt-text-muted">No customers found.</td></tr>
        <% } %>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td><%= u.phone || '—' %></td>
            <td><%= new Date(u.createdAt).toLocaleDateString('en-IN') %></td>
            <td><span class="gt-pill <%= u.isBlocked ? 'gt-pill-danger' : 'gt-pill-success' %>"><%= u.isBlocked ? 'Blocked' : 'Active' %></span></td>
            <td>
              <form class="gt-inline-form" method="POST" action="/admin/users/<%= u._id %>/toggle-block" data-confirm="<%= u.isBlocked ? 'Unblock' : 'Block' %> this user?">
                <button class="gt-btn <%= u.isBlocked ? 'gt-btn-success' : 'gt-btn-danger' %> gt-btn-sm" type="submit">
                  <%= u.isBlocked ? 'Unblock' : 'Block' %>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <div class="gt-pagination" style="padding: 0 22px 20px;">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="/admin/users?page=<%= i %>&search=<%= search %>" class="<%= currentPage === i ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
  <% } %>
</div>
