<div class="gt-card">

    <div class="gt-card-header d-flex justify-content-between align-items-center">

        <div>
            <h3>Return Requests</h3>
            <p>Manage customer return & replacement requests.</p>
        </div>

        <form method="GET" action="/admin/returns">

            <select
                name="status"
                class="form-select"
                onchange="this.form.submit()"
            >

                <option value="">All Status</option>

                <option value="pending" <%= status==="pending" ? "selected":"" %>>
                    Pending
                </option>

                <option value="approved" <%= status==="approved" ? "selected":"" %>>
                    Approved
                </option>

                <option value="rejected" <%= status==="rejected" ? "selected":"" %>>
                    Rejected
                </option>

                <option value="completed" <%= status==="completed" ? "selected":"" %>>
                    Completed
                </option>

            </select>

        </form>

    </div>

    <div class="gt-card-body">

        <table class="table table-bordered table-hover">

            <thead>

                <tr>
                    <th>#</th>
                    <th>Order No</th>
                    <th>Customer</th>
                    <th>Request</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody>

                <% if(requests.length===0){ %>

                    <tr>
                        <td colspan="8" class="text-center">
                            No Return Requests Found
                        </td>
                    </tr>

                <% } %>

                <% requests.forEach(function(item,index){ %>

                    <tr>

                        <td>
                            <%= (currentPage-1)*10 + index + 1 %>
                        </td>

                        <td>
                            <%= item.order?.orderNumber || "-" %>
                        </td>

                        <td>
                            <%= item.user?.name || "Guest User" %>
                        </td>

                        <td class="text-capitalize">
                            <%= item.requestType %>
                        </td>

                        <td>
                            <%= item.reason %>
                        </td>

                        <td>

                            <% if(item.status==="pending"){ %>
                                <span class="badge bg-warning">Pending</span>
                            <% } %>

                            <% if(item.status==="approved"){ %>
                                <span class="badge bg-success">Approved</span>
                            <% } %>

                            <% if(item.status==="rejected"){ %>
                                <span class="badge bg-danger">Rejected</span>
                            <% } %>

                            <% if(item.status==="completed"){ %>
                                <span class="badge bg-primary">Completed</span>
                            <% } %>

                        </td>

                        <td>
                            <%= new Date(item.createdAt).toLocaleDateString() %>
                        </td>

                        <td>

                            <a
                                href="/admin/returns/<%= item._id %>"
                                class="btn btn-sm btn-primary"
                            >
                                View
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

        <% if(totalPages>1){ %>

            <nav>

                <ul class="pagination justify-content-center">

                    <% for(let i=1;i<=totalPages;i++){ %>

                        <li class="page-item <%= currentPage===i ? 'active':'' %>">

                            <a
                                class="page-link"
                                href="/admin/returns?page=<%= i %>&status=<%= status %>"
                            >
                                <%= i %>
                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

    </div>

</div>