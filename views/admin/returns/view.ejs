<div class="gt-card">

    <div class="gt-card-header">

        <div>

            <h2>Return Request Details</h2>

            <p class="gt-text-muted">
                View customer request and update its status.
            </p>

        </div>

        <a
            href="/admin/returns"
            class="gt-btn gt-btn-outline">

            ← Back

        </a>

    </div>

    <div class="gt-card-body">

        <div class="gt-table-wrap">

            <table class="gt-table">

                <tbody>

                    <tr>
                        <th width="220">Customer</th>
                        <td><%= request.user?.name || "Guest User" %></td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td><%= request.user?.email || "-" %></td>
                    </tr>

                    <tr>
                        <th>Phone</th>
                        <td><%= request.user?.phone || "-" %></td>
                    </tr>

                    <tr>
                        <th>Order Number</th>
                        <td>
                            <strong>
                                <%= request.order?.orderNumber || "-" %>
                            </strong>
                        </td>
                    </tr>

                    <tr>
                        <th>Order Amount</th>
                        <td>
                            ₹ <%= request.order?.totalPrice || 0 %>
                        </td>
                    </tr>

                    <tr>
                        <th>Request Type</th>
                        <td style="text-transform:capitalize;">
                            <%= request.requestType %>
                        </td>
                    </tr>

                    <tr>
                        <th>Reason</th>
                        <td>
                            <%= request.reason %>
                        </td>
                    </tr>

                    <tr>
                        <th>Description</th>
                        <td>
                            <%= request.description || "-" %>
                        </td>
                    </tr>

                    <tr>

                        <th>Current Status</th>

                        <td>

                            <% if(request.status==="pending"){ %>

                                <span class="gt-pill gt-pill-warning">
                                    Pending
                                </span>

                            <% } %>

                            <% if(request.status==="approved"){ %>

                                <span class="gt-pill gt-pill-success">
                                    Approved
                                </span>

                            <% } %>

                            <% if(request.status==="rejected"){ %>

                                <span class="gt-pill gt-pill-danger">
                                    Rejected
                                </span>

                            <% } %>

                            <% if(request.status==="completed"){ %>

                                <span class="gt-pill gt-pill-primary">
                                    Completed
                                </span>

                            <% } %>

                        </td>

                    </tr>

                    <tr>

                        <th>Requested On</th>

                        <td>

                            <%= new Date(request.createdAt).toLocaleString() %>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <hr style="margin:30px 0;">

        <form
            method="POST"
            action="/admin/returns/<%= request._id %>/status">

            <div class="gt-form-group">

                <label>

                    Update Status

                </label>

                <select
                    name="status"
                    class="gt-select">

                    <option value="pending" <%= request.status==="pending" ? "selected":"" %>>
                        Pending
                    </option>

                    <option value="approved" <%= request.status==="approved" ? "selected":"" %>>
                        Approved
                    </option>

                    <option value="rejected" <%= request.status==="rejected" ? "selected":"" %>>
                        Rejected
                    </option>

                    <option value="completed" <%= request.status==="completed" ? "selected":"" %>>
                        Completed
                    </option>

                </select>

            </div>

            <button
                type="submit"
                class="gt-btn gt-btn-primary">

                Update Status

            </button>

        </form>

    </div>

</div>