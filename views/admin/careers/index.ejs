<div class="gt-card">

    <div class="gt-card-header">

        <div>
            <h2>Careers</h2>
            <p class="gt-text-muted">
                Manage all career openings.
            </p>
        </div>

        <a
            href="/admin/careers/add"
            class="gt-btn gt-btn-primary">

            + Add Career

        </a>

    </div>

    <div class="gt-table-wrap">

        <table class="gt-table">

            <thead>

                <tr>

                    <th>#</th>
                    <th>Job Title</th>
                    <th>Work Mode</th>
                    <th>Employment Type</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th style="width:240px;">Actions</th>

                </tr>

            </thead>

            <tbody>

                <% if(careers.length === 0){ %>

                    <tr>

                        <td colspan="7" class="gt-text-muted">

                            No career openings found.

                        </td>

                    </tr>

                <% } %>

                <% careers.forEach(function(career,index){ %>

                    <tr>

                        <td>

                            <%= index + 1 %>

                        </td>

                        <td>

                            <strong>

                                <%= career.title %>

                            </strong>

                        </td>

                        <td>

                            <%= career.workMode %>

                        </td>

                        <td>

                            <%= career.employmentType %>

                        </td>

                        <td style="max-width:360px;">

                            <%
                                const plainDescription = career.description.replace(/<[^>]*>/g, "");
                            %>

                            <%= plainDescription.length > 100
                                ? plainDescription.substring(0,100) + "..."
                                : plainDescription
                            %>

                        </td>

                        <td>

                            <% if(career.isActive){ %>

                                <span class="gt-pill gt-pill-success">

                                    Active

                                </span>

                            <% } else { %>

                                <span class="gt-pill gt-pill-danger">

                                    Inactive

                                </span>

                            <% } %>

                        </td>

                        <td style="white-space:nowrap;">

                            <a
                                href="/admin/careers/edit/<%= career._id %>"
                                class="gt-btn gt-btn-outline gt-btn-sm">

                                Edit

                            </a>

                            <form
                                class="gt-inline-form"
                                action="/admin/careers/delete/<%= career._id %>"
                                method="POST"
                                data-confirm="Delete this career permanently?">

                                <button
                                    type="submit"
                                    class="gt-btn gt-btn-danger gt-btn-sm">

                                    Delete

                                </button>

                            </form>

                            <form
                                class="gt-inline-form"
                                action="/admin/careers/<%= career._id %>/toggle-active"
                                method="POST">

                                <button
                                    type="submit"
                                    class="gt-btn <%= career.isActive ? 'gt-btn-outline' : 'gt-btn-primary' %> gt-btn-sm">

                                    <%= career.isActive ? 'Deactivate' : 'Activate' %>

                                </button>

                            </form>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>