<div class="gt-card">

    <div class="gt-card-header">
        <h3>Edit Career</h3>
        <p>Update career opening details.</p>
    </div>

    <div class="gt-card-body">

        <form action="/admin/careers/edit/<%= career._id %>" method="POST">

            <div class="mb-3">
                <label class="form-label">Job Title</label>
                <input
                    type="text"
                    name="title"
                    class="form-control"
                    value="<%= career.title %>"
                    required
                >
            </div>

            <div class="mb-3">
                <label class="form-label">Work Mode</label>
        <select
    name="workMode"
    class="form-select"
>

<option
value="On-site"
<%= career.workMode==="On-site"?"selected":"" %>>
On-site
</option>

<option
value="Remote"
<%= career.workMode==="Remote"?"selected":"" %>>
Remote
</option>

<option
value="Hybrid"
<%= career.workMode==="Hybrid"?"selected":"" %>>
Hybrid
</option>

</select>
            </div>

            <div class="mb-3">
                <label class="form-label">Emploment Type</label>

               <select
name="employmentType"
class="form-select"
>

<option
value="Full-time"
<%= career.employmentType==="Full-time"?"selected":"" %>>
Full-time
</option>

<option
value="Part-time"
<%= career.employmentType==="Part-time"?"selected":"" %>>
Part-time
</option>

<option
value="Internship"
<%= career.employmentType==="Internship"?"selected":"" %>>
Internship
</option>

<option
value="Contract"
<%= career.employmentType==="Contract"?"selected":"" %>>
Contract
</option>

</select>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>

                <textarea
                    name="description"
                    rows="6"
                    class="form-control"
                    required
                ><%= career.description %></textarea>
            </div>

            <button
                type="submit"
                class="btn btn-primary"
            >
                Update Career
            </button>

            <a
                href="/admin/careers"
                class="btn btn-secondary"
            >
                Cancel
            </a>

        </form>

    </div>

</div>