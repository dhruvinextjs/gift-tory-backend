<div class="gt-card">

  <div class="gt-card-header">
    <h2>Add Career</h2>

    <a href="/admin/careers" class="gt-btn gt-btn-outline">
      ← Back to List
    </a>
  </div>

  <div class="gt-card-body">

    <form method="POST" action="/admin/careers/add">

      <div class="gt-form-grid">

        <div class="gt-form-group">
          <label>Job Title *</label>

          <input
            type="text"
            name="title"
            class="gt-input"
            placeholder="Enter job title"
            required
          >
        </div>

        <div class="gt-form-group">

          <label>Work Mode *</label>

          <select
            name="workMode"
            class="gt-select"
            required
          >
            <option value="">Select Work Mode</option>
            <option value="On-site">On-site</option>
            <option value="Remote">Remote</option>
            <option value="Hybrid">Hybrid</option>
          </select>

        </div>

      </div>


      <div class="gt-form-grid">

        <div class="gt-form-group">

          <label>Employment Type *</label>

          <select
            name="employmentType"
            class="gt-select"
            required
          >
            <option value="">Select Employment Type</option>
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Internship">Internship</option>
            <option value="Contract">Contract</option>
          </select>

        </div>

      </div>


      <div class="gt-form-group">

        <label>Description *</label>

        <textarea
          id="editor"
          name="description"
        ></textarea>

        <div class="gt-hint">
          Add complete job description, responsibilities and requirements.
        </div>

      </div>


      <div style="display:flex; gap:10px; margin-top:24px;">

        <button
          type="submit"
          class="gt-btn gt-btn-primary"
        >
          Save Career
        </button>

        <a
          href="/admin/careers"
          class="gt-btn gt-btn-outline"
        >
          Cancel
        </a>

      </div>

    </form>

  </div>

</div>


<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

<script>
ClassicEditor
.create(document.querySelector("#editor"))
.catch(error => console.error(error));
</script>