<div class="gt-card">
  <div class="gt-card-header">
    <h2>Add Banner</h2>
    <a href="/admin/banners" class="gt-btn gt-btn-outline">← Back to list</a>
  </div>
  <div class="gt-card-body">
    <form method="POST" action="/admin/banners/add" enctype="multipart/form-data">
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Title *</label>
          <input class="gt-input" type="text" name="title" required />
        </div>
        <div class="gt-form-group">
          <label>Subtitle</label>
          <input class="gt-input" type="text" name="subtitle" />
        </div>
      </div>
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Link URL (optional)</label>
          <input class="gt-input" type="text" name="link" placeholder="/products?category=..." />
        </div>
        <div class="gt-form-group">
          <label>Position *</label>
          <select class="gt-select" name="position" required>
            <option value="hero">Hero (top slider)</option>
            <option value="deal">Deal of the Day</option>
            <option value="gift_for_her">Gifts for Her</option>
            <option value="gift_for_him">Gifts for Him</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Display Order</label>
          <input class="gt-input" type="number" name="displayOrder" value="0" />
        </div>
        <div class="gt-form-group" style="align-self:end;">
          <label class="gt-checkbox-row"><input type="checkbox" name="isActive" checked /> Active</label>
        </div>
      </div>
      <div class="gt-form-group">
        <label>Banner Image * (recommended 1600x600)</label>
        <input class="gt-input" type="file" name="image" accept="image/*" data-preview-input="imgPreview" required />
        <div class="gt-image-preview" id="imgPreview"></div>
      </div>
      <button type="submit" class="gt-btn gt-btn-primary">Save Banner</button>
    </form>
  </div>
</div>
