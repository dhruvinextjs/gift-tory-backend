<div class="gt-card">
  <div class="gt-card-header">
    <h2>Homepage Banners</h2>
    <a href="/admin/banners/add" class="gt-btn gt-btn-primary">+ Add Banner</a>
  </div>
  <div class="gt-table-wrap">
    <table class="gt-table">
      <thead><tr><th>Image</th><th>Title</th><th>Position</th><th>Order</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (banners.length === 0) { %>
          <tr><td colspan="6" class="gt-text-muted">No banners yet.</td></tr>
        <% } %>
        <% banners.forEach(b => { %>
          <tr>
            <td><img class="gt-table-thumb" src="/uploads/banners/<%= b.image %>" onerror="this.src='https://via.placeholder.com/44'" alt="" /></td>
            <td><%= b.title %></td>
            <td><span class="gt-pill gt-pill-info"><%= b.position %></span></td>
            <td><%= b.displayOrder %></td>
            <td><span class="gt-pill <%= b.isActive ? 'gt-pill-success' : 'gt-pill-gray' %>"><%= b.isActive ? 'Active' : 'Hidden' %></span></td>
            <td style="white-space:nowrap;">
              <form class="gt-inline-form" method="POST" action="/admin/banners/<%= b._id %>/toggle-active">
                <button class="gt-btn gt-btn-outline gt-btn-sm" type="submit"><%= b.isActive ? 'Hide' : 'Show' %></button>
              </form>
              <form class="gt-inline-form" method="POST" action="/admin/banners/delete/<%= b._id %>" data-confirm="Delete this banner?">
                <button class="gt-btn gt-btn-danger gt-btn-sm" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
