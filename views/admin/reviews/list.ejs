<div class="gt-card">
  <div class="gt-card-header"><h2>Product Reviews</h2></div>

  <div class="gt-table-wrap">
    <table class="gt-table">
      <thead><tr><th>Product</th><th>Customer</th><th>Rating</th><th>Comment</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (reviews.length === 0) { %>
          <tr><td colspan="6" class="gt-text-muted">No reviews yet.</td></tr>
        <% } %>
        <% reviews.forEach(r => { %>
          <tr>
            <td><%= r.product ? r.product.name : 'Deleted product' %></td>
            <td><%= r.user ? r.user.name : 'Deleted user' %></td>
            <td>⭐ <%= r.rating %></td>
            <td style="max-width:280px;"><%= r.comment %></td>
            <td><span class="gt-pill <%= r.isApproved ? 'gt-pill-success' : 'gt-pill-gray' %>"><%= r.isApproved ? 'Approved' : 'Hidden' %></span></td>
            <td style="white-space:nowrap;">
              <form class="gt-inline-form" method="POST" action="/admin/reviews/<%= r._id %>/toggle-approve">
                <button class="gt-btn gt-btn-outline gt-btn-sm" type="submit"><%= r.isApproved ? 'Hide' : 'Approve' %></button>
              </form>
              <form class="gt-inline-form" method="POST" action="/admin/reviews/<%= r._id %>/delete" data-confirm="Delete this review?">
                <button class="gt-btn gt-btn-danger gt-btn-sm" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
