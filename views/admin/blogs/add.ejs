<div class="gt-card">
  <div class="gt-card-header">
    <h2>Add Blog Post</h2>
    <a href="/admin/blogs" class="gt-btn gt-btn-outline">← Back to list</a>
  </div>
  <div class="gt-card-body">
    <form method="POST" action="/admin/blogs/add" enctype="multipart/form-data">
      <div class="gt-form-group">
        <label>Title *</label>
        <input class="gt-input" type="text" name="title" required />
      </div>
      <div class="gt-form-group">
        <label>Excerpt (short summary)</label>
        <input class="gt-input" type="text" name="excerpt" />
      </div>
      <div class="gt-form-group">
        <label>Content *</label>
        <textarea class="gt-input" name="content" rows="8" required></textarea>
      </div>
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Author</label>
          <input class="gt-input" type="text" name="author" value="Gifttory Team" />
        </div>
        <div class="gt-form-group">
          <label>Tags (comma separated)</label>
          <input class="gt-input" type="text" name="tags" placeholder="gifting, tips" />
        </div>
        <div class="gt-form-group" style="align-self:end;">
          <label class="gt-checkbox-row"><input type="checkbox" name="isPublished" checked /> Publish immediately</label>
        </div>
      </div>
      <div class="gt-form-group">
        <label>Cover Image *</label>
        <input class="gt-input" type="file" name="coverImage" accept="image/*" data-preview-input="imgPreview" required />
        <div class="gt-image-preview" id="imgPreview"></div>
      </div>
      <button type="submit" class="gt-btn gt-btn-primary">Save Blog Post</button>
    </form>
  </div>
</div>
