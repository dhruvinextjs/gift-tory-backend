<div class="gt-card">
  <div class="gt-card-header">
    <div>
      <h2>Add Category</h2>
      <p class="gt-card-subtitle">Create a new product category</p>
    </div>
    <a href="/admin/categories" class="gt-btn gt-btn-outline">
      <i class="material-icons">arrow_back</i>
      Back to list
    </a>
  </div>

  <div class="gt-card-body">
    <form method="POST" action="/admin/categories/add" enctype="multipart/form-data" class="gt-form">

      <!-- Name -->
      <div class="gt-form-group">
        <label>Category Name <span class="gt-required">*</span></label>
        <input class="gt-input" type="text" name="name" placeholder="e.g. Birthday Gifts" required />
      </div>

      <!-- Description -->
      <div class="gt-form-group">
        <label>Description</label>
        <textarea class="gt-input gt-textarea" name="description" rows="3" placeholder="Short description (optional)"></textarea>
      </div>

      <!-- Order + Active (same row) -->
<!-- Order + Active (same row) -->
<div class="gt-form-grid">
  <div class="gt-form-group">
    <label>Display Order</label>
    <input class="gt-input" type="number" name="displayOrder" value="0" min="0" />
  </div>

  <div class="gt-form-group">
    <label>Status</label>
    <label class="gt-checkbox-row">
      <input type="checkbox" name="isActive" checked />
      <span>Active (visible on site)</span>
    </label>
  </div>
</div>

      <!-- Image -->
      <div class="gt-form-group">
        <label>Category Image <span class="gt-required">*</span></label>
        <input
          class="gt-input"
          type="file"
          name="image"
          accept="image/*"
          data-preview-input="imgPreview"
          required
        />
        <div class="gt-image-preview" id="imgPreview"></div>
      </div>

      <!-- Actions -->
      <div class="gt-form-actions">
        <button type="submit" class="gt-btn gt-btn-primary">
          <i class="material-icons">save</i>
          Save Category
        </button>
        <a href="/admin/categories" class="gt-btn gt-btn-outline">Cancel</a>
      </div>

    </form>
  </div>
</div>