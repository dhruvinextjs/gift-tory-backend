<div class="gt-card">
  <div class="gt-card-header">
    <h2>Edit Category</h2>
    <a href="/admin/categories" class="gt-btn gt-btn-outline">← Back to list</a>
  </div>
  <div class="gt-card-body">
    <form method="POST" action="/admin/categories/edit/<%= category._id %>" enctype="multipart/form-data">
      <div class="gt-form-group">
        <label>Category Name *</label>
        <input class="gt-input" type="text" name="name" value="<%= category.name %>" required />
      </div>
      <div class="gt-form-group">
        <label>Description</label>
        <textarea class="gt-input" name="description" rows="3"><%= category.description %></textarea>
      </div>
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Display Order</label>
          <input class="gt-input" type="number" name="displayOrder" value="<%= category.displayOrder %>" />
        </div>
        <div class="gt-form-group" style="align-self:end;">
          <label class="gt-checkbox-row"><input type="checkbox" name="isActive" <%= category.isActive ? 'checked' : '' %> /> Active (visible on site)</label>
        </div>
      </div>
      <div class="gt-form-group">
        <label>Current Image</label>
        <div class="gt-image-preview"><img src="/uploads/categories/<%= category.image %>" alt="" /></div>
      </div>
      <div class="gt-form-group">
        <label>Replace Image (optional)</label>
        <input class="gt-input" type="file" name="image" accept="image/*" data-preview-input="imgPreview" />
        <div class="gt-image-preview" id="imgPreview"></div>
      </div>
      <button type="submit" class="gt-btn gt-btn-primary">Update Category</button>
    </form>
  </div>
</div>
