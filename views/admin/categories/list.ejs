<div class="gt-card">
  <div class="gt-card-header">
    <div>
      <h2>Categories</h2>
      <p class="gt-card-subtitle">Manage product categories</p>
    </div>
    <a href="/admin/categories/add" class="gt-btn gt-btn-primary">
      <i class="material-icons">add</i>
      Add Category
    </a>
  </div>

  <div class="gt-table-wrap">
    <table class="gt-table">
      <thead>
        <tr>
          <th class="gt-th-img">Image</th>
          <th>Name</th>
          <th class="gt-th-order">Order</th>
          <th class="gt-th-status">Status</th>
          <th class="gt-th-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!categories || categories.length === 0) { %>
          <tr>
            <td colspan="5" class="gt-empty-state">
              <i class="material-icons">category</i>
              <p>No categories yet</p>
              <a href="/admin/categories/add" class="gt-btn gt-btn-primary gt-btn-sm">Add first category</a>
            </td>
          </tr>
        <% } else { %>
          <% categories.forEach(c => { %>
            <tr>
              <td class="gt-td-img">
                <div class="gt-thumb-box">
                  <img
                    class="gt-table-thumb"
                    src="/uploads/categories/<%= c.image %>"
                    onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2248%22 height=%2248%22%3E%3Crect fill=%22%23f0f0f0%22 width=%2248%22 height=%2248%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%23aaa%22 font-size=%2210%22%3ENo Img%3C/text%3E%3C/svg%3E'"
                    alt="<%= c.name %>"
                    width="48"
                    height="48"
                  />
                </div>
              </td>
              <td>
                <div class="gt-cell-title"><%= c.name %></div>
                <% if (c.description) { %>
                  <div class="gt-cell-sub"><%= c.description.substring(0, 60) %><%= c.description.length > 60 ? '…' : '' %></div>
                <% } %>
              </td>
              <td>
                <span class="gt-order-badge"><%= c.displayOrder %></span>
              </td>
              <td>
                <span class="gt-pill <%= c.isActive ? 'gt-pill-success' : 'gt-pill-gray' %>">
                  <%= c.isActive ? 'Active' : 'Hidden' %>
                </span>
              </td>
              <td>
                <div class="gt-actions">
                  <a class="gt-btn gt-btn-outline gt-btn-sm" href="/admin/categories/edit/<%= c._id %>">
                    Edit
                  </a>
                  <form
                    class="gt-inline-form"
                    method="POST"
                    action="/admin/categories/delete/<%= c._id %>"
                    data-confirm="Delete this category?"
                  >
                    <button class="gt-btn gt-btn-danger gt-btn-sm" type="submit">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>