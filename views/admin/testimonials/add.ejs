<div class="gt-card">
  <div class="gt-card-header">
    <h2>Add Testimonial</h2>
    <a href="/admin/testimonials" class="gt-btn gt-btn-outline">← Back to list</a>
  </div>
  <div class="gt-card-body">
    <form method="POST" action="/admin/testimonials/add" enctype="multipart/form-data">
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Customer Name *</label>
          <input class="gt-input" type="text" name="name" required />
        </div>
        <div class="gt-form-group">
          <label>Designation</label>
          <input class="gt-input" type="text" name="designation" placeholder="e.g. Customer, Artist" />
        </div>
      </div>
      <div class="gt-form-group">
        <label>Message *</label>
        <textarea class="gt-input" name="message" rows="3" required></textarea>
      </div>
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Rating</label>
          <select class="gt-select" name="rating">
            <option value="5" selected>5</option>
            <option value="4">4</option>
            <option value="3">3</option>
            <option value="2">2</option>
            <option value="1">1</option>
          </select>
        </div>
        <div class="gt-form-group">
          <label>Display Order</label>
          <input class="gt-input" type="number" name="displayOrder" value="0" />
        </div>
        <div class="gt-form-group" style="align-self:end;">
          <label class="gt-checkbox-row"><input type="checkbox" name="isActive" checked /> Active</label>
        </div>
      </div>
      <div class="gt-form-group">
        <label>Photo</label>
        <input class="gt-input" type="file" name="image" accept="image/*" data-preview-input="imgPreview" />
        <div class="gt-image-preview" id="imgPreview"></div>
      </div>
      <button type="submit" class="gt-btn gt-btn-primary">Save Testimonial</button>
    </form>
  </div>
</div>
