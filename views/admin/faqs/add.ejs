<div class="gt-card">

    <div class="gt-card-header">

        <h2>Add FAQ</h2>

        <a href="/admin/faqs" class="gt-btn gt-btn-outline">

            ← Back to list

        </a>

    </div>

    <div class="gt-card-body">

        <form method="POST" action="/admin/faqs/add">

            <div class="gt-form-group">

                <label>Question *</label>

                <input
                    type="text"
                    name="question"
                    class="gt-input"
                    placeholder="Enter FAQ Question"
                    required
                >

            </div>

            <div class="gt-form-group">

                <label>Answer *</label>

                <textarea
                    name="answer"
                    rows="8"
                    class="gt-input"
                    placeholder="Enter FAQ Answer"
                    required
                ></textarea>

            </div>

            <div class="gt-form-grid">

                <div class="gt-form-group">

                    <label>Display Order</label>

                    <input
                        type="number"
                        name="order"
                        class="gt-input"
                        value="0"
                    >

                </div>

                <div
                    class="gt-form-group"
                    style="align-self:end;"
                >

                    <label class="gt-checkbox-row">

                        <input
                            type="checkbox"
                            name="isActive"
                            checked
                        >

                        Active

                    </label>

                </div>

            </div>

            <button
                type="submit"
                class="gt-btn gt-btn-primary"
            >

                Save FAQ

            </button>

        </form>

    </div>

</div>