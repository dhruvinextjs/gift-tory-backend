<div class="gt-card">

    <div class="gt-card-header">

        <h2>FAQs</h2>

        <a href="/admin/faqs/add" class="gt-btn gt-btn-primary">

            + Add FAQ

        </a>

    </div>

    <div class="gt-table-wrap">

        <table class="gt-table">

            <thead>

                <tr>

                    <th>#</th>

                    <th>Question</th>

                    <th>Status</th>

                    <th>Order</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% if(faqs.length===0){ %>

                    <tr>

                        <td colspan="5" class="gt-text-muted">

                            No FAQs Found.

                        </td>

                    </tr>

                <% } %>

                <% faqs.forEach((faq,index)=>{ %>

                    <tr>

                        <td>

                            <%= index+1 %>

                        </td>

                        <td>

                            <strong><%= faq.question %></strong>

                            <br>

                            <small class="gt-text-muted">

                                <%= faq.answer.substring(0,80) %>

                                <% if(faq.answer.length>80){ %>

                                    ...

                                <% } %>

                            </small>

                        </td>

                        <td>

                            <span class="gt-pill <%= faq.isActive ? 'gt-pill-success':'gt-pill-gray' %>">

                                <%= faq.isActive ? 'Active':'Inactive' %>

                            </span>

                        </td>

                        <td>

                            <%= faq.order %>

                        </td>

                        <td style="white-space:nowrap;">

                            <a

                                href="/admin/faqs/edit/<%= faq._id %>"

                                class="gt-btn gt-btn-outline gt-btn-sm">

                                Edit

                            </a>

                            <form

                                class="gt-inline-form"

                                method="POST"

                                action="/admin/faqs/delete/<%= faq._id %>"

                                data-confirm="Delete this FAQ?">

                                <button

                                    class="gt-btn gt-btn-danger gt-btn-sm"

                                    type="submit">

                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>