<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — Gifttory</title>
  <link rel="stylesheet" href="/admin/css/style.css" />
</head>
<body>
  <div class="gt-login-wrap">
    <div class="gt-login-card">
      <div class="gt-login-logo">
        <div class="gt-logo-mark">GT</div>
      </div>
      <div class="gt-login-title">Gifttory Admin</div>
      <div class="gt-login-subtitle">Sign in to manage your store</div>

      <% if (typeof error !== 'undefined' && error.length) { %>
        <div class="gt-alert gt-alert-error">⚠️ <%= error[0] %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="gt-form-group">
          <label for="email">Email address</label>
          <input class="gt-input" type="email" id="email" name="email" placeholder="admin@gifttory.com" required />
        </div>
        <div class="gt-form-group">
          <label for="password">Password</label>
          <input class="gt-input" type="password" id="password" name="password" placeholder="••••••••" required />
        </div>
        <button type="submit" class="gt-btn gt-btn-primary" style="width:100%; justify-content:center; padding:11px;">
          Sign In
        </button>
      </form>
    </div>
  </div>
</body>
</html>
