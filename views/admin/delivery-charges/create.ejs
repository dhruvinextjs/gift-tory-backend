<div class="gt-card">

    <div class="gt-card-header">

        <h2>Add Delivery Charge</h2>

        <a
            href="/admin/delivery-charges"
            class="gt-btn gt-btn-outline">

            ← Back to List

        </a>

    </div>

    <div class="gt-card-body">

        <form
            action="/admin/delivery-charges/create"
            method="POST">

            <div class="gt-form-grid">

                <div class="gt-form-group">

                    <label>Delivery Type *</label>

                    <select
                        name="deliveryType"
                        class="gt-select"
                        required>

                        <option value="">Select Delivery Type</option>

                        <option>Standard Delivery</option>

                        <option>Fixed Time Delivery</option>

                        <option>Early Morning Delivery</option>

                        <option>Midnight Delivery</option>

                    </select>

                </div>

                <div class="gt-form-group">

                    <label>Time Slot</label>

                    <input
                        type="text"
                        name="timeSlot"
                        class="gt-input"
                        placeholder="Example : 10 AM - 2 PM">

                </div>

            </div>

            <div class="gt-form-grid">

                <div class="gt-form-group">

                    <label>Delivery Charge (₹) *</label>

                    <input
                        type="number"
                        name="deliveryCharge"
                        class="gt-input"
                        placeholder="Enter delivery charge"
                        required>

                </div>

            </div>

            <div class="gt-form-group">

                <label class="gt-checkbox-row">

                    <input
                        type="checkbox"
                        checked
                        name="isActive">

                    Active

                </label>

            </div>

            <button
                type="submit"
                class="gt-btn gt-btn-primary">

                Save Delivery Charge

            </button>

        </form>

    </div>

</div>