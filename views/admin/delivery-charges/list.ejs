<div class="gt-card">
  <div class="gt-card-header">
    <h2>Delivery Charges</h2>

    <a href="/admin/delivery-charges/add" class="gt-btn gt-btn-primary">
      + Add Delivery Charge
    </a>
  </div>

  <div class="gt-table-wrap">

    <table class="gt-table">

      <thead>
        <tr>
          <th>Delivery Type</th>
          <th>Time Slot</th>
          <th>Charge</th>
          <th>Status</th>
          <th style="width:180px;">Actions</th>
        </tr>
      </thead>

      <tbody>

      <% if(deliveryCharges.length===0){ %>

        <tr>
          <td colspan="5" class="gt-text-muted">
            No delivery charges found.
          </td>
        </tr>

      <% } %>

      <% deliveryCharges.forEach(item=>{ %>

      <tr>

        <td>
          <strong><%= item.deliveryType %></strong>
        </td>

        <td>
          <%= item.timeSlot || "—" %>
        </td>

        <td>
          ₹<%= item.deliveryCharge %>
        </td>

        <td>

          <span class="gt-pill <%= item.isActive ? 'gt-pill-success' : 'gt-pill-gray' %>">

            <%= item.isActive ? "Active" : "Inactive" %>

          </span>

        </td>

        <td style="white-space:nowrap;">

          <a
            href="/admin/delivery-charges/edit/<%= item._id %>"
            class="gt-btn gt-btn-outline gt-btn-sm">

            Edit

          </a>

          <form
            class="gt-inline-form"
            method="POST"
            action="/admin/delivery-charges/delete/<%= item._id %>"
            data-confirm="Delete this delivery charge?">

            <button
              type="submit"
              class="gt-btn gt-btn-danger gt-btn-sm">

              Delete

            </button>

          </form>

        </td>

      </tr>

      <% }) %>

      </tbody>

    </table>

  </div>
</div>