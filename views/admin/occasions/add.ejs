<div class="gt-card">
  <div class="gt-card-header">
    <h2>Add Occasion</h2>
    <a href="/admin/occasions" class="gt-btn gt-btn-outline">← Back to list</a>
  </div>
  <div class="gt-card-body">
    <form method="POST" action="/admin/occasions/add" enctype="multipart/form-data">
      <div class="gt-form-group">
        <label>Occasion Name *</label>
        <input class="gt-input" type="text" name="name" required />
      </div>
      <div class="gt-form-group">
        <label>Description</label>
        <textarea class="gt-input" name="description" rows="3"></textarea>
      </div>
      <div class="gt-form-grid">
        <div class="gt-form-group">
          <label>Display Order</label>
          <input class="gt-input" type="number" name="displayOrder" value="0" />
        </div>
        <div class="gt-form-group" style="align-self:end;">
          <label class="gt-checkbox-row"><input type="checkbox" name="isActive" checked /> Active (visible on site)</label>
        </div>
      </div>
      <div class="gt-form-group">
        <label>Occasion Image *</label>
        <input class="gt-input" type="file" name="image" accept="image/*" data-preview-input="imgPreview" required />
        <div class="gt-image-preview" id="imgPreview"></div>
      </div>
      <button type="submit" class="gt-btn gt-btn-primary">Save Occasion</button>
    </form>
  </div>
</div>
