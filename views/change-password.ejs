<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<!-- BEGIN: Head-->

<head>
    <%- include('_layouts/head') %>
        <title>Change Password</title>
        <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/login.css">
</head>
<!-- END: Head-->

<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 1-column login-bg blank-page blank-page"
    data-open="click" data-menu="vertical-dark-menu" data-col="1-column">

    <div class="row login-container">
        <div class="col s12">
            <div class="container">

                <div id="login-page" class="row">

                    <div class="col s12 m6 l4 z-depth-4 card-panel border-radius-6 login-card bg-opacity-8"
                        style="background-color: white;">

                        <form class="login-form" id="changePasswordForm"
                            action="/admin/change-password" method="post"
                            onsubmit="return validate()">

                            <div class="row">

                                <!-- Logo -->
                                <div class="s12" style="text-align: center;">
                                    <br />
                                    <img src="/img/Logo.png" width="30%" />
                                </div>

                                <!-- Title -->
                                <div class="col s12"
                                    style="text-align: center;margin-bottom: 20px;">
                                    <br />
                                    <span
                                        style="font-size: 22px;font-weight: 900;color: black;">
                                        CHANGE PASSWORD
                                    </span>
                                </div>

                            </div>

                            <!-- Error -->
                            <% if (error) { %>
                                <div style="color:red; text-align:center; margin-bottom:10px;">
                                    <%= error %>
                                </div>
                            <% } %>

                            <!-- Success / Flash Messages -->
                            <%- include('messages', {
                                messages: typeof messages !== 'undefined'
                                    ? messages
                                    : { success: [], error: [] }
                            }) %>


                            <!-- Current Password -->
                            <div class="row margin">
                                <div class="input-field col s12">

                                    <i class="material-icons prefix pt-2">
                                        lock_outline
                                    </i>

                                    <input
                                        id="currentPassword"
                                        type="password"
                                        name="currentPassword"
                                        required
                                    />

                                    <label for="currentPassword">
                                        Current Password
                                    </label>

                                    <i class="material-icons toggle-password"
                                        data-target="currentPassword"
                                        style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); cursor: pointer; user-select: none;">
                                        visibility_off
                                    </i>

                                    <small>
                                        <div id="error1"
                                            class="error"
                                            style="margin-left: 3rem;">
                                        </div>
                                    </small>

                                </div>
                            </div>


                            <!-- New Password -->
                            <div class="row margin">
                                <div class="input-field col s12">

                                    <i class="material-icons prefix pt-2">
                                        lock_outline
                                    </i>

                                    <input
                                        id="newPassword"
                                        type="password"
                                        name="newPassword"
                                        minlength="8"
                                        required
                                    />

                                    <label for="newPassword">
                                        New Password
                                    </label>

                                    <i class="material-icons toggle-password"
                                        data-target="newPassword"
                                        style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); cursor: pointer; user-select: none;">
                                        visibility_off
                                    </i>

                                    <small>
                                        <div id="error2"
                                            class="error"
                                            style="margin-left: 3rem;">
                                        </div>
                                    </small>

                                </div>
                            </div>


                            <!-- Confirm New Password -->
                            <div class="row margin">
                                <div class="input-field col s12">

                                    <i class="material-icons prefix pt-2">
                                        lock_outline
                                    </i>

                                    <input
                                        id="confirmPassword"
                                        type="password"
                                        name="confirmPassword"
                                        minlength="8"
                                        required
                                    />

                                    <label for="confirmPassword">
                                        Confirm New Password
                                    </label>

                                    <i class="material-icons toggle-password"
                                        data-target="confirmPassword"
                                        style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); cursor: pointer; user-select: none;">
                                        visibility_off
                                    </i>

                                    <small>
                                        <div id="error3"
                                            class="error"
                                            style="margin-left: 3rem;">
                                        </div>
                                    </small>

                                </div>
                            </div>


                            <!-- Submit -->
                            <div class="row">
                                <div class="input-field col s12 mb-10">

                                    <button
                                        class="btn waves-effect waves-light border-round col s12"
                                        type="submit"
                                        id="submitBtn"
                                        style="background-color: #3D3D3D;">
                                        Change Password
                                    </button>

                                </div>
                            </div>


                            <!-- Back -->
                            <div class="row">
                                <div class="col s12"
                                    style="text-align: center; margin-bottom: 20px;">

                                    <a href="/admin/dashboard"
                                        style="color: #3D3D3D; font-size: 14px;">
                                        ← Back to Dashboard
                                    </a>

                                </div>
                            </div>

                        </form>

                    </div>

                </div>

            </div>

            <div class="content-overlay"></div>

        </div>
    </div>


    <script>

        const form = document.getElementById('changePasswordForm');

        // Prevent default submit
        form.addEventListener('submit', (e) => {
            e.preventDefault();
        });


        function validate() {

            let returnVal = true;

            const currentPassword =
                document.getElementById('currentPassword');

            const newPassword =
                document.getElementById('newPassword');

            const confirmPassword =
                document.getElementById('confirmPassword');


            const currentPasswordValue =
                currentPassword.value.trim();

            const newPasswordValue =
                newPassword.value.trim();

            const confirmPasswordValue =
                confirmPassword.value.trim();


            // Current Password
            if (currentPasswordValue == '') {

                document.getElementById('error1').innerText =
                    'Please enter current password.';

                returnVal = false;

            } else {

                document.getElementById('error1').innerText = '';

            }


            // New Password
            if (newPasswordValue == '') {

                document.getElementById('error2').innerText =
                    'Please enter new password.';

                returnVal = false;

            } else if (newPasswordValue.length < 8) {

                document.getElementById('error2').innerText =
                    'Password should atleast 8 characters long.';

                returnVal = false;

            } else {

                document.getElementById('error2').innerText = '';

            }


            // Confirm Password
            if (confirmPasswordValue == '') {

                document.getElementById('error3').innerText =
                    'Please confirm new password.';

                returnVal = false;

            } else if (confirmPasswordValue.length < 8) {

                document.getElementById('error3').innerText =
                    'Password should atleast 8 characters long.';

                returnVal = false;

            } else if (newPasswordValue !== confirmPasswordValue) {

                document.getElementById('error3').innerText =
                    'New password and confirm password do not match.';

                returnVal = false;

            } else {

                document.getElementById('error3').innerText = '';

            }


            // Submit
            if (returnVal) {

                document.getElementById('submitBtn').disabled = true;

                form.submit();

            }

            return false;
        }


        // Password visibility toggle
        const togglePasswords =
            document.querySelectorAll('.toggle-password');

        togglePasswords.forEach(function (toggle) {

            toggle.addEventListener('click', function () {

                const targetId =
                    this.getAttribute('data-target');

                const passwordInput =
                    document.getElementById(targetId);

                const type =
                    passwordInput.getAttribute('type') === 'password'
                        ? 'text'
                        : 'password';

                passwordInput.setAttribute('type', type);

                this.textContent =
                    type === 'password'
                        ? 'visibility_off'
                        : 'visibility';

            });

        });

    </script>

    <%- include('_layouts/commonJs') %>

</body>

</html>