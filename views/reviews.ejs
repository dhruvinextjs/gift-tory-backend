<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>

    <%- include('_layouts/head') %>

    <title>Reviews | <%= title %></title>


    <!-- DataTables CSS -->

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/select.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/css/pages/data-tables.css"
    >


    <style>

        /* =========================================
           REVIEWS PAGE
           Same UI style as Orders page
        ========================================= */


        /* Table */

        table tr td,
        table tr th {

            text-align: center;

            vertical-align: middle !important;

            padding: 12px 10px !important;

        }


        /* Product */

        .review-product {

            font-weight: 600;

            color: #333;

        }


        /* Customer */

        .review-customer {

            font-weight: 500;

            color: #424242;

        }


        /* Rating */

        .review-rating {

            font-weight: 600;

            color: #f59e0b;

            white-space: nowrap;

        }


        /* Comment */

        .review-comment {

            color: #555;

            max-width: 280px;

            margin: 0 auto;

            line-height: 1.5;

            word-break: break-word;

        }


        /* Status */

        .review-status {

            padding: 16px 12px;

            border-radius: 20px;

            font-size: 0.8rem;

            font-weight: 600;

            display: inline-block;

            text-transform: capitalize;

            color: #fff;

            white-space: nowrap;

        }


        /* Approved */

        .review-status-approved {

            background: #16a34a;

        }


        /* Hidden */

        .review-status-hidden {

            background: #757575;

        }


        /* Actions */

        .review-actions {

            display: flex;

            gap: 6px;

            justify-content: center;

            align-items: center;

        }


        .review-actions form {

            margin: 0;

        }


        .review-actions .btn-small {

            margin: 0;

        }


        /* Empty state */

        .review-empty {

            text-align: center !important;

            padding: 40px !important;

        }


        .review-empty i {

            display: block;

            font-size: 40px;

            color: #bdbdbd;

            margin-bottom: 8px;

        }


        .review-empty p {

            color: #9e9e9e;

            margin: 0;

        }


        /* Pagination */

        .review-pagination {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 5px;

            margin-top: 20px;

        }


        .review-pagination a {

            min-width: 32px;

            height: 32px;

            line-height: 32px;

            text-align: center;

            border-radius: 3px;

            color: #555;

            text-decoration: none;

            border: 1px solid #ddd;

            font-size: 13px;

        }


        .review-pagination a:hover {

            background: #f5f5f5;

        }


        .review-pagination a.active {

            background: #26a69a;

            border-color: #26a69a;

            color: #fff;

        }


        /* Responsive */

        @media (max-width: 768px) {

            table {

                min-width: 950px;

            }

        }

    </style>

</head>


<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click"
    data-menu="vertical-dark-menu"
    data-col="2-columns"
>


    <!-- SIDEBAR -->

    <%- include('_layouts/sidenavbar') %>


    <!-- MAIN -->

    <div id="main">

        <div class="row">


            <!-- =========================================
                 PAGE HEADER
            ========================================== -->

            <div
                id="breadcrumbs-wrapper"
                class="order-page-header"
            >

                <div class="container">

                    <div class="row">


                        <!-- PAGE TITLE -->

                        <div class="col s12 m6 l6">

                            <h6 class="breadcrumbs-title">

                                Manage Reviews

                            </h6>

                        </div>


                        <!-- BREADCRUMBS -->

                        <div
                            class="col s12 m6 l6 right-align-md"
                            style="margin-top:-10px;"
                        >

                            <ol class="breadcrumbs mb-0">

                                <li class="breadcrumb-item">

                                    <a href="/admin/dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="breadcrumb-item active">

                                    Reviews

                                </li>

                            </ol>

                        </div>

                    </div>


                    <!-- =====================================
                         DESCRIPTION
                    ====================================== -->

                    <div class="row">

                        <div class="col s12 m6">

                            <h5 class="mt-0">

                                Product Reviews

                            </h5>


                            <p class="grey-text">

                                View and manage customer product reviews

                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================
                 MESSAGES
            ========================================== -->

            <%- include('messages', { messages: messages }) %>


            <!-- =========================================
                 MAIN CONTENT
            ========================================== -->

            <div class="col s12">

                <div class="container">

                    <div class="section section-data-tables">


                        <div class="row">

                            <div class="col s12">


                                <div class="card">

                                    <div class="card-content">


                                        <!-- =================================
                                             TABLE
                                        ================================== -->

                                        <div class="row">

                                            <div class="col s12 overflow">


                                                <table
                                                    id="page-length-option"
                                                    class="display"
                                                >

                                                    <thead>

                                                        <tr>

                                                            <th>
                                                                Product
                                                            </th>

                                                            <th>
                                                                Customer
                                                            </th>

                                                            <th>
                                                                Rating
                                                            </th>

                                                            <th>
                                                                Comment
                                                            </th>

                                                            <th>
                                                                Status
                                                            </th>

                                                            <th>
                                                                Actions
                                                            </th>

                                                        </tr>

                                                    </thead>


                                                    <tbody>


                                                        <% if (!reviews || reviews.length === 0) { %>


                                                            <!-- EMPTY STATE -->

                                                            <tr>

                                                                <td
                                                                    colspan="6"
                                                                    class="review-empty"
                                                                >

                                                                    <i class="material-icons">

                                                                        rate_review

                                                                    </i>


                                                                    <p>

                                                                        No reviews found

                                                                    </p>

                                                                </td>

                                                            </tr>


                                                        <% } else { %>


                                                            <% reviews.forEach(r => { %>


                                                                <tr>


                                                                    <!-- =========================
                                                                         PRODUCT
                                                                    ========================== -->

                                                                    <td>

                                                                        <span class="review-product">

                                                                            <%= r.product
                                                                                ? r.product.name
                                                                                : 'Deleted product'
                                                                            %>

                                                                        </span>

                                                                    </td>


                                                                    <!-- =========================
                                                                         CUSTOMER
                                                                    ========================== -->

                                                                    <td>

                                                                        <span class="review-customer">

                                                                            <%= r.user
                                                                                ? r.user.name
                                                                                : 'Deleted user'
                                                                            %>

                                                                        </span>

                                                                    </td>


                                                                    <!-- =========================
                                                                         RATING
                                                                    ========================== -->

                                                                    <td>

                                                                        <span class="review-rating">

                                                                            ⭐ <%= r.rating %>

                                                                        </span>

                                                                    </td>


                                                                    <!-- =========================
                                                                         COMMENT
                                                                    ========================== -->

                                                                    <td>

                                                                        <div class="review-comment">

                                                                            <%= r.comment || 'No comment' %>

                                                                        </div>

                                                                    </td>


                                                                    <!-- =========================
                                                                         STATUS
                                                                    ========================== -->

                                                                    <td>

                                                                        <span
                                                                            class="review-status
                                                                            <%= r.isApproved
                                                                                ? 'review-status-approved'
                                                                                : 'review-status-hidden'
                                                                            %>"
                                                                        >

                                                                            <%= r.isApproved
                                                                                ? 'Approved'
                                                                                : 'Hidden'
                                                                            %>

                                                                        </span>

                                                                    </td>


                                                                    <!-- =========================
                                                                         ACTIONS
                                                                    ========================== -->

                                                                    <td>

                                                                        <div class="review-actions">


                                                                            <!-- APPROVE / HIDE -->

                                                                            <form
                                                                                method="POST"
                                                                                action="/admin/reviews/<%= r._id %>/toggle-approve"
                                                                            >

                                                                                <button
                                                                                    class="btn-small waves-effect waves-light"
                                                                                    type="submit"
                                                                                    title="<%= r.isApproved ? 'Hide Review' : 'Approve Review' %>"
                                                                                >

                                                                                    <i class="material-icons left">

                                                                                        <%= r.isApproved
                                                                                            ? 'visibility_off'
                                                                                            : 'check'
                                                                                        %>

                                                                                    </i>

                                                                                    <%= r.isApproved
                                                                                        ? 'Hide'
                                                                                        : 'Approve'
                                                                                    %>

                                                                                </button>

                                                                            </form>


                                                                            <!-- DELETE -->

                                                                            <form
                                                                                method="POST"
                                                                                action="/admin/reviews/<%= r._id %>/delete"
                                                                                data-confirm="Delete this review?"
                                                                            >

                                                                                <button
                                                                                    class="btn-small red waves-effect waves-light"
                                                                                    type="submit"
                                                                                    title="Delete Review"
                                                                                >

                                                                                    <i class="material-icons left">

                                                                                        delete

                                                                                    </i>

                                                                                    Delete

                                                                                </button>

                                                                            </form>


                                                                        </div>

                                                                    </td>


                                                                </tr>


                                                            <% }) %>


                                                        <% } %>


                                                    </tbody>

                                                </table>


                                            </div>

                                        </div>


                                        <!-- =================================
                                             PAGINATION
                                        ================================== -->

                                        <% if (
                                            typeof totalPages !== 'undefined' &&
                                            totalPages > 1
                                        ) { %>


                                            <div class="review-pagination">


                                                <% for (
                                                    let i = 1;
                                                    i <= totalPages;
                                                    i++
                                                ) { %>


                                                    <a
                                                        href="/admin/reviews?page=<%= i %>"
                                                        class="<%= currentPage === i ? 'active' : '' %>"
                                                    >

                                                        <%= i %>

                                                    </a>


                                                <% } %>


                                            </div>


                                        <% } %>


                                    </div>

                                </div>


                            </div>

                        </div>


                    </div>

                </div>

            </div>


        </div>

    </div>


    <!-- =========================================
         COMMON JS
    ========================================== -->

    <%- include('_layouts/commonJs') %>


    <!-- =========================================
         DATATABLE JS
    ========================================== -->

    <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>

    <script src="/app-assets/js/scripts/data-tables.js"></script>


    <!-- =========================================
         DELETE CONFIRMATION
    ========================================== -->

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            const confirmForms =
                document.querySelectorAll('form[data-confirm]');


            confirmForms.forEach(function (form) {

                form.addEventListener('submit', function (e) {

                    const message =
                        form.getAttribute('data-confirm');


                    if (!confirm(message)) {

                        e.preventDefault();

                    }

                });

            });

        });

    </script>


</body>

</html>