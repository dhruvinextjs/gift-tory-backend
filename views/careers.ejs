<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>

    <%- include('_layouts/head') %>

    <title>Careers | <%= title %></title>


    <!-- DataTables CSS -->

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/select.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/css/pages/data-tables.css"
    >


    <style>

        /* =========================================
           CAREERS PAGE
           Same UI style as Categories page
        ========================================= */


        /* Table */

        table tr td,
        table tr th {

            text-align: center;

            vertical-align: middle !important;

            padding: 10px 8px !important;

        }


        /* Career title */

        .career-title {

            font-weight: 600;

            color: #333;

        }


        /* Work mode */

        .career-work-mode {

            font-weight: 500;

            color: #555;

            text-transform: capitalize;

        }


        /* Employment type */

        .career-employment-type {

            font-weight: 500;

            color: #555;

            text-transform: capitalize;

        }


        /* Description */

        .career-description {

              display: -webkit-box;
    color: #757575;
    font-size: 13px;
    line-height: 18px;
    max-width: 250px;
    margin: 0 auto;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;

        }


        /* Status */

        .career-status {

            padding: 16px 12px;

            border-radius: 20px;

            font-size: 0.8rem;

            font-weight: 600;

            display: inline-block;

            text-transform: capitalize;

            color: #fff;

            white-space: nowrap;

        }


        .career-status-active {

            background: #16a34a;

        }


        .career-status-hidden {

            background: #757575;

        }


        /* Actions */

        .career-actions {

            display: flex;

            gap: 6px;

            justify-content: center;

            align-items: center;

            flex-wrap: wrap;

        }


        .career-actions .btn-floating {

            margin: 0;

        }


        /* Row hover */

        tr.career-row {

            cursor: pointer;

        }


        tr.career-row:hover {

            background: #f5f5f5;

        }


        td.actions-column {

            cursor: default;

        }


        /* Add career button */

        .career-add-wrapper {

            display: flex;

            justify-content: flex-end;

            padding: 6px 0;

            margin-bottom: 5px;

        }


        /* Empty state */

        .career-empty {

            text-align: center !important;

            padding: 30px !important;

        }


        .career-empty i {

            display: block;

            font-size: 36px;

            color: #bdbdbd;

            margin-bottom: 8px;

        }


        .career-empty span {

            color: #9e9e9e;

        }


        /* Pagination */

        .career-pagination {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 5px;

            margin-top: 20px;

        }


        .career-pagination a {

            min-width: 32px;

            height: 32px;

            line-height: 32px;

            text-align: center;

            border-radius: 3px;

            color: #555;

            text-decoration: none;

            border: 1px solid #ddd;

            font-size: 13px;

        }


        .career-pagination a:hover {

            background: #f5f5f5;

        }


        .career-pagination a.active {

            background: #26a69a;

            border-color: #26a69a;

            color: #fff;

        }


        /* Responsive */

        @media (max-width: 768px) {

            .career-add-wrapper {

                justify-content: flex-start;

            }


            table {

                min-width: 1000px;

            }

        }

    </style>

</head>


<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click"
    data-menu="vertical-dark-menu"
    data-col="2-columns"
>


    <!-- SIDEBAR -->

    <%- include('_layouts/sidenavbar') %>


    <!-- MAIN -->

    <div id="main">

        <div class="row">


            <!-- =========================================
                 BREADCRUMB HEADER
            ========================================== -->

            <div
                class="pt-1 pb-0"
                id="breadcrumbs-wrapper"
            >

                <div class="container">

                    <div class="row">


                        <!-- MESSAGES -->

                        <%- include('messages', { messages: messages }) %>


                        <!-- PAGE TITLE -->

                        <div class="col s12 m6 l6">

                            <h6 class="breadcrumbs-title">

                                Manage Careers

                            </h6>

                        </div>


                        <!-- BREADCRUMBS -->

                        <div
                            class="col s12 m6 l6 right-align-md"
                            style="margin-top:-10px;"
                        >

                            <ol class="breadcrumbs mb-0">

                                <li class="breadcrumb-item">

                                    <a href="/admin/dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="breadcrumb-item active">

                                    Careers

                                </li>

                            </ol>

                        </div>

                    </div>


                    <!-- =====================================
                         ADD CAREER
                    ====================================== -->

                    <div class="career-add-wrapper">

                        <a
                            class="btn btn-add btn-breadcrumbs white-text"
                            href="/admin/careers/add"
                        >

                            + Add Career

                        </a>

                    </div>


                    <!-- =====================================
                         CARD HEADER
                    ====================================== -->

                    <div class="row">

                        <div class="col s12 m6">

                            <h5 class="mt-0">

                                All Careers

                            </h5>


                            <p class="grey-text">

                                View and manage all career openings

                            </p>

                        </div>

                    </div>


                    <!-- =====================================
                         MAIN CONTENT
                    ====================================== -->

                    <div class="col s12">

                        <div class="container">

                            <div class="section section-data-tables">

                                <div class="row">

                                    <div class="col s12">


                                        <div class="card">

                                            <div class="card-content">


                                                <!-- =================================
                                                     TABLE
                                                ================================== -->

                                                <div class="row">

                                                    <div class="col s12 overflow">


                                                        <table
                                                            id="page-length-option"
                                                            class="display"
                                                        >

                                                            <thead>

                                                                <tr>

                                                                    <th>

                                                                        Sr

                                                                    </th>


                                                                    <th>

                                                                        Job Title

                                                                    </th>


                                                                    <th>

                                                                        Work Mode

                                                                    </th>


                                                                    <th>

                                                                        Employment Type

                                                                    </th>


                                                                    <th>

                                                                        Description

                                                                    </th>


                                                                    <th>

                                                                        Status

                                                                    </th>


                                                                    <th>

                                                                        Actions

                                                                    </th>

                                                                </tr>

                                                            </thead>


                                                            <tbody>


                                                                <% if (!careers || careers.length === 0) { %>


                                                                    <!-- EMPTY STATE -->

                                                                    <tr>

                                                                        <td
                                                                            colspan="7"
                                                                            class="career-empty"
                                                                        >

                                                                            <i class="material-icons">

                                                                                work_outline

                                                                            </i>


                                                                            <span>

                                                                                No career openings found

                                                                            </span>

                                                                        </td>

                                                                    </tr>


                                                                <% } else { %>


                                                                    <% careers.forEach(function(career, index) { %>


                                                                        <tr
                                                                            class="career-row"
                                                                            data-href="/admin/careers/edit/<%= career._id %>"
                                                                        >


                                                                            <!-- =========================
                                                                                 SR
                                                                            ========================== -->

                                                                            <td>

                                                                                <%= index + 1 %>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 JOB TITLE
                                                                            ========================== -->

                                                                            <td>

                                                                                <span class="career-title">

                                                                                    <%= career.title %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 WORK MODE
                                                                            ========================== -->

                                                                            <td>

                                                                                <span class="career-work-mode">

                                                                                    <%= career.workMode %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 EMPLOYMENT TYPE
                                                                            ========================== -->

                                                                            <td>

                                                                                <span class="career-employment-type">

                                                                                    <%= career.employmentType %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 DESCRIPTION
                                                                            ========================== -->

                                                                            <td>

                                                                                <%
                                                                                    const plainDescription =
                                                                                        career.description
                                                                                            ? career.description.replace(/<[^>]*>/g, "")
                                                                                            : "";
                                                                                %>


                                                                                <% if (plainDescription) { %>

                                                                                    <span class="career-description">

                                                                                        <%= plainDescription.length > 100
                                                                                            ? plainDescription.substring(0, 100) + "..."
                                                                                            : plainDescription
                                                                                        %>

                                                                                    </span>

                                                                                <% } else { %>

                                                                                    <span class="grey-text">

                                                                                        N/A

                                                                                    </span>

                                                                                <% } %>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 STATUS
                                                                            ========================== -->

                                                                            <td>

                                                                                <span
                                                                                    class="career-status
                                                                                    <%= career.isActive
                                                                                        ? 'career-status-active'
                                                                                        : 'career-status-hidden'
                                                                                    %>"
                                                                                >

                                                                                    <%= career.isActive
                                                                                        ? 'Active'
                                                                                        : 'Inactive'
                                                                                    %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 ACTIONS
                                                                            ========================== -->

                                                                            <td class="actions-column">

                                                                                <div class="career-actions">


                                                                                    <!-- EDIT -->

                                                                                    <a
                                                                                        href="/admin/careers/edit/<%= career._id %>"
                                                                                        class="btn-floating waves-effect waves-light accent-2"
                                                                                        title="Edit"
                                                                                    >

                                                                                        <i class="material-icons">

                                                                                            edit

                                                                                        </i>

                                                                                    </a>


                                                                                    <!-- DELETE -->

                                                                                    <a
                                                                                        href="#"
                                                                                        class="btn-floating waves-effect waves-light red btn-delete-career"
                                                                                        data-id="<%= career._id %>"
                                                                                        data-name="<%= career.title %>"
                                                                                        title="Delete"
                                                                                    >

                                                                                        <i class="material-icons">

                                                                                            delete

                                                                                        </i>

                                                                                    </a>


                                                                                    <!-- ACTIVATE / DEACTIVATE -->

                                                                                    <form
                                                                                        action="/admin/careers/<%= career._id %>/toggle-active"
                                                                                        method="POST"
                                                                                        style="display:inline;"
                                                                                    >

                                                                                        <button
                                                                                            type="submit"
                                                                                            class="btn-floating waves-effect waves-light <%= career.isActive ? 'grey' : 'green' %>"
                                                                                            title="<%= career.isActive ? 'Deactivate' : 'Activate' %>"
                                                                                        >

                                                                                            <i class="material-icons">

                                                                                                <%= career.isActive
                                                                                                    ? 'visibility_off'
                                                                                                    : 'visibility'
                                                                                                %>

                                                                                            </i>

                                                                                        </button>

                                                                                    </form>


                                                                                </div>

                                                                            </td>


                                                                        </tr>


                                                                    <% }) %>


                                                                <% } %>


                                                            </tbody>

                                                        </table>


                                                    </div>

                                                </div>


                                                <!-- =================================
                                                     PAGINATION
                                                ================================== -->

                                                <% if (
                                                    typeof totalPages !== 'undefined' &&
                                                    totalPages > 1
                                                ) { %>


                                                    <div class="career-pagination">


                                                        <% for (
                                                            let i = 1;
                                                            i <= totalPages;
                                                            i++
                                                        ) { %>


                                                            <a
                                                                href="/admin/careers?page=<%= i %>"
                                                                class="<%= currentPage === i ? 'active' : '' %>"
                                                            >

                                                                <%= i %>

                                                            </a>


                                                        <% } %>


                                                    </div>


                                                <% } %>


                                            </div>

                                        </div>


                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                </div>

            </div>


        </div>

    </div>


    <!-- =========================================
         COMMON JS
    ========================================== -->

    <%- include('_layouts/commonJs') %>


    <!-- =========================================
         DATATABLE JS
    ========================================== -->

    <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>

    <script src="/app-assets/js/scripts/data-tables.js"></script>


    <script>

        document.addEventListener('DOMContentLoaded', function () {


            /* =========================================
               CAREER ROW CLICK
            ========================================= */

            document
                .querySelectorAll('.career-row')
                .forEach(function (row) {


                    row.addEventListener('click', function (e) {


                        /*
                         * Do not redirect when
                         * clicking action buttons/forms
                         */

                        if (

                            e.target.closest('.actions-column') ||

                            e.target.closest('a') ||

                            e.target.closest('button') ||

                            e.target.closest('form')

                        ) {

                            return;

                        }


                        const href =
                            row.getAttribute('data-href');


                        if (href) {

                            window.location.href = href;

                        }

                    });

                });



            /* =========================================
               DELETE CAREER
            ========================================== */

            document
                .querySelectorAll('.btn-delete-career')
                .forEach(function (button) {


                    button.addEventListener('click', function (e) {


                        e.preventDefault();


                        const id =
                            this.dataset.id;


                        const name =
                            this.dataset.name;



                        if (!confirm(

                            'Delete career "' +
                            name +
                            '"? This cannot be undone.'

                        )) {

                            return;

                        }



                        const form =
                            document.createElement('form');


                        form.method = 'POST';


                        form.action =
                            '/admin/careers/delete/' + id;



                        document.body.appendChild(form);


                        form.submit();

                    });

                });


        });

    </script>


</body>

</html>