<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>

    <%- include('_layouts/head') %>

    <title>Shops | <%= title %></title>

    <style>

        /* =========================================
           SHOPS PAGE
           Same UI style as Categories page
        ========================================= */

        /* Form Card */

        .shop-form-card {
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .shop-form-body {
            padding: 30px !important;
        }

        .form-section {
            margin-bottom: 30px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 18px;
            font-weight: 600;
            color: #333;
            margin-bottom: 20px;
        }

        .section-title i {
            color: #26a69a;
            font-size: 22px;
        }

        .form-field {
            margin-bottom: 20px;
        }

        .form-field label {
            font-size: 14px;
            color: #555;
            font-weight: 500;
        }

        .required {
            color: #e53935;
        }

        .form-hint {
            display: block;
            color: #9e9e9e;
            font-size: 12px;
            margin-top: 6px;
        }

        /* Textarea */

        .shop-textarea {
            min-height: 100px;
            resize: vertical;
        }

        /* File Upload */

        .file-upload-box {
            border: 2px dashed #ddd;
            border-radius: 8px;
            padding: 25px;
            text-align: center;
            background: #fafafa;
            transition: all 0.2s ease;
        }

        .file-upload-box:hover {
            border-color: #26a69a;
            background: #f8fffe;
        }

        .file-upload-box i {
            font-size: 40px;
            color: #26a69a;
            margin-bottom: 8px;
        }

        .file-upload-box label {
            display: block;
            margin-bottom: 12px;
            font-weight: 600;
            color: #444;
        }

        .file-upload-box input[type="file"] {
            width: 100%;
        }

        /* Buttons */

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding-top: 20px;
            border-top: 1px solid #eeeeee;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #7b1fa2, #ab47bc) !important;
            border-radius: 4px;
            box-shadow: none;
        }

        .btn-gradient:hover {
            box-shadow: 0 4px 12px rgba(123, 31, 162, 0.25);
        }

        /* Shop Cards */

        .shops-list-section {
            margin-top: 35px;
        }

        .shop-card {
            border-radius: 10px;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .shop-card-content {
            padding: 22px;
        }

        .shop-card-title {
            font-size: 20px;
            font-weight: 600;
            color: #333;
            margin: 0 0 15px;
        }

        .shop-info {
            margin-bottom: 9px;
            font-size: 14px;
            color: #555;
            line-height: 1.5;
        }

        .shop-info strong {
            color: #333;
        }

        .shop-location {
            color: #26a69a;
            font-weight: 500;
        }

        .shop-images {
            margin-top: 20px;
        }

        .shop-image-wrapper {
            margin-bottom: 15px;
        }

        .shop-image {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 7px;
            border: 1px solid #eeeeee;
            display: block;
        }

        .shop-delete-wrapper {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #eeeeee;
        }

        .shop-delete-button {
            width: 100%;
            border-radius: 4px;
        }

        /* Empty State */

        .shop-empty {
            text-align: center;
            padding: 50px 20px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .shop-empty i {
            display: block;
            font-size: 50px;
            color: #bdbdbd;
            margin-bottom: 10px;
        }

        .shop-empty span {
            color: #9e9e9e;
            font-size: 15px;
        }

        /* Page Header */

        .shop-page-header {
            margin-bottom: 20px;
        }

        .shop-page-header h5 {
            margin-bottom: 5px;
        }

        .shop-page-header p {
            margin-top: 0;
        }

        /* Responsive */

        @media (max-width: 768px) {

            .shop-form-body {
                padding: 20px !important;
            }

            .form-actions {
                justify-content: flex-start;
                flex-wrap: wrap;
            }

            .shop-image {
                height: 140px;
            }

        }

    </style>

</head>


<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click"
    data-menu="vertical-dark-menu"
    data-col="2-columns"
>


    <!-- SIDEBAR -->

    <%- include('_layouts/sidenavbar') %>


    <!-- MAIN -->

    <div id="main">

        <div class="row">


            <!-- Breadcrumb Header -->

            <div
                class="pt-1 pb-0"
                id="breadcrumbs-wrapper"
            >

                <div class="container">

                    <div class="row">


                        <!-- Messages -->

                        <%- include('messages', { messages: messages }) %>


                        <!-- Page Title -->

                        <div class="col s12 m6 l6">

                            <h6 class="breadcrumbs-title">

                                Manage Gift Shops

                            </h6>

                        </div>


                        <!-- Breadcrumbs -->

                        <div
                            class="col s12 m6 l6 right-align-md"
                            style="margin-top:-10px;"
                        >

                            <ol class="breadcrumbs mb-0">

                                <li class="breadcrumb-item">

                                    <a href="/admin/dashboard">

                                        Dashboard

                                    </a>

                                </li>

                                <li class="breadcrumb-item active">

                                    Shops

                                </li>

                            </ol>

                        </div>

                    </div>


                    <!-- Page Header -->

                    <div class="row shop-page-header">

                        <div class="col s12">

                            <h5 class="mt-0">

                                Gift Shops

                            </h5>

                            <p class="grey-text">

                                Add and manage gift shops displayed on the website

                            </p>

                        </div>

                    </div>


                    <!-- Add Shop Form -->

                    <div class="row">

                        <div class="col s12">

                            <div class="card shop-form-card">

                                <div class="card-content shop-form-body">


                                    <form
                                        action="/admin/shops"
                                        method="POST"
                                        enctype="multipart/form-data"
                                    >


                                        <!-- ========================= -->
                                        <!-- Shop Details -->
                                        <!-- ========================= -->

                                        <div class="form-section">

                                            <h6 class="section-title">

                                                <i class="material-icons">

                                                    store

                                                </i>

                                                Shop Details

                                            </h6>


                                            <div class="row">


                                                <!-- Shop Name -->

                                                <div class="input-field col s12 m6">

                                                    <input
                                                        type="text"
                                                        id="shopName"
                                                        name="shopName"
                                                        required
                                                    >

                                                    <label for="shopName">

                                                        Shop Name
                                                        <span class="required">*</span>

                                                    </label>

                                                </div>


                                                <!-- Location -->

                                                <div class="input-field col s12 m6">

                                                    <input
                                                        type="text"
                                                        id="location"
                                                        name="location"
                                                        required
                                                    >

                                                    <label for="location">

                                                        Location
                                                        <span class="required">*</span>

                                                    </label>

                                                </div>


                                                <!-- Description -->

                                                <div class="input-field col s12">

                                                    <textarea
                                                        id="description"
                                                        name="description"
                                                        class="materialize-textarea shop-textarea"
                                                    ></textarea>

                                                    <label for="description">

                                                        Description

                                                    </label>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- ========================= -->
                                        <!-- Opening Details -->
                                        <!-- ========================= -->

                                        <div class="form-section">

                                            <h6 class="section-title">

                                                <i class="material-icons">

                                                    access_time

                                                </i>

                                                Opening Details

                                            </h6>


                                            <div class="row">


                                                <!-- Open Days -->

                                                <div class="input-field col s12 m6">

                                                    <input
                                                        type="text"
                                                        id="openDays"
                                                        name="openDays"
                                                        placeholder="Open 7 Days A Week"
                                                    >

                                                    <label for="openDays">

                                                        Open Days

                                                    </label>

                                                </div>


                                                <!-- Opening Time -->

                                                <div class="input-field col s12 m6">

                                                    <input
                                                        type="text"
                                                        id="openingTime"
                                                        name="openingTime"
                                                        placeholder="11:00 AM - 9:00 PM"
                                                    >

                                                    <label for="openingTime">

                                                        Opening Time

                                                    </label>

                                                </div>


                                                <!-- Address -->

                                                <div class="input-field col s12">

                                                    <textarea
                                                        id="address"
                                                        name="address"
                                                        class="materialize-textarea shop-textarea"
                                                    ></textarea>

                                                    <label for="address">

                                                        Address

                                                    </label>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- ========================= -->
                                        <!-- Contact Details -->
                                        <!-- ========================= -->

                                        <div class="form-section">

                                            <h6 class="section-title">

                                                <i class="material-icons">

                                                    phone

                                                </i>

                                                Contact Details

                                            </h6>


                                            <div class="row">


                                                <!-- Phone 1 -->

                                                <div class="input-field col s12 m6">

                                                    <input
                                                        type="text"
                                                        id="phone1"
                                                        name="phone1"
                                                    >

                                                    <label for="phone1">

                                                        Phone Number 1

                                                    </label>

                                                </div>


                                                <!-- Phone 2 -->

                                                <div class="input-field col s12 m6">

                                                    <input
                                                        type="text"
                                                        id="phone2"
                                                        name="phone2"
                                                    >

                                                    <label for="phone2">

                                                        Phone Number 2

                                                    </label>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- ========================= -->
                                        <!-- Personal Shopper -->
                                        <!-- ========================= -->

                                        <div class="form-section">

                                            <h6 class="section-title">

                                                <i class="material-icons">

                                                    person

                                                </i>

                                                Personal Shopper

                                            </h6>


                                            <div class="row">


                                                <div class="input-field col s12 m4">

                                                    <input
                                                        type="text"
                                                        id="personalShopper1"
                                                        name="personalShopper1"
                                                    >

                                                    <label for="personalShopper1">

                                                        Personal Shopper 1

                                                    </label>

                                                </div>


                                                <div class="input-field col s12 m4">

                                                    <input
                                                        type="text"
                                                        id="personalShopper2"
                                                        name="personalShopper2"
                                                    >

                                                    <label for="personalShopper2">

                                                        Personal Shopper 2

                                                    </label>

                                                </div>


                                                <div class="input-field col s12 m4">

                                                    <input
                                                        type="text"
                                                        id="personalShopper3"
                                                        name="personalShopper3"
                                                    >

                                                    <label for="personalShopper3">

                                                        Personal Shopper 3

                                                    </label>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- ========================= -->
                                        <!-- Shop Images -->
                                        <!-- ========================= -->

                                        <div class="form-section">

                                            <h6 class="section-title">

                                                <i class="material-icons">

                                                    photo_library

                                                </i>

                                                Shop Images

                                            </h6>


                                            <div class="row">


                                                <!-- Multiple Images -->

                                                <div class="col s12">

                                                    <div class="file-upload-box">

                                                        <i class="material-icons">

                                                            cloud_upload

                                                        </i>

                                                        <label for="images">

                                                            Upload Multiple Images
                                                            <span class="required">*</span>

                                                        </label>

                                                        <input
                                                            type="file"
                                                            id="images"
                                                            name="images"
                                                            multiple
                                                            accept="image/*"
                                                            required
                                                        >

                                                        <span class="form-hint">

                                                            Select multiple shop images.

                                                        </span>

                                                    </div>

                                                </div>


                                                <!-- Display Order -->

                                                <div class="input-field col s12 m4">

                                                    <input
                                                        type="number"
                                                        id="displayOrder"
                                                        name="displayOrder"
                                                        value="0"
                                                        min="0"
                                                    >

                                                    <label for="displayOrder">

                                                        Display Order

                                                    </label>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- Actions -->

                                        <div class="form-actions">

                                            <a
                                                href="/admin/dashboard"
                                                class="btn-flat waves-effect"
                                            >

                                                Cancel

                                            </a>

                                            <button
                                                class="btn waves-effect waves-light btn-gradient"
                                                type="submit"
                                            >

                                                <i class="material-icons left">

                                                    save

                                                </i>

                                                Save Shop

                                            </button>

                                        </div>


                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- Added Shops -->
                    <!-- ========================= -->

                    <div class="shops-list-section">

                        <div class="row">

                            <div class="col s12">

                                <h5 class="mt-0">

                                    Added Shops

                                </h5>

                                <p class="grey-text">

                                    View and manage all added gift shops

                                </p>

                            </div>

                        </div>


                        <div class="row">


                            <% if (!shops || shops.length === 0) { %>


                                <div class="col s12">

                                    <div class="shop-empty">

                                        <i class="material-icons">

                                            store

                                        </i>

                                        <span>

                                            No shops found

                                        </span>

                                    </div>

                                </div>


                            <% } else { %>


                                <% shops.forEach(shop => { %>


                                    <div class="col s12 l6">

                                        <div class="card shop-card">

                                            <div class="shop-card-content">


                                                <!-- Shop Name -->

                                                <h5 class="shop-card-title">

                                                    <%= shop.shopName %>

                                                </h5>


                                                <!-- Location -->

                                                <div class="shop-info">

                                                    <strong>Location:</strong>

                                                    <span class="shop-location">

                                                        <%= shop.location || 'N/A' %>

                                                    </span>

                                                </div>


                                                <!-- Open Days -->

                                                <div class="shop-info">

                                                    <strong>Open Days:</strong>

                                                    <%= shop.openDays || 'N/A' %>

                                                </div>


                                                <!-- Opening Time -->

                                                <div class="shop-info">

                                                    <strong>Opening Time:</strong>

                                                    <%= shop.openingTime || 'N/A' %>

                                                </div>


                                                <!-- Address -->

                                                <div class="shop-info">

                                                    <strong>Address:</strong>

                                                    <%= shop.address || 'N/A' %>

                                                </div>


                                                <!-- Phone 1 -->

                                                <div class="shop-info">

                                                    <strong>Phone 1:</strong>

                                                    <%= shop.phone1 || 'N/A' %>

                                                </div>


                                                <!-- Phone 2 -->

                                                <div class="shop-info">

                                                    <strong>Phone 2:</strong>

                                                    <%= shop.phone2 || 'N/A' %>

                                                </div>


                                                <!-- Personal Shopper -->

                                                <div class="shop-info">

                                                    <strong>Personal Shopper:</strong>

                                                    <%= shop.personalShopper1 || 'N/A' %>,
                                                    <%= shop.personalShopper2 || 'N/A' %>,
                                                    <%= shop.personalShopper3 || 'N/A' %>

                                                </div>


                                                <!-- Images -->

                                                <% if (shop.images && shop.images.length > 0) { %>


                                                    <div class="row shop-images">


                                                        <% shop.images.forEach(image => { %>


                                                            <div class="col s12 m4 shop-image-wrapper">

                                                                <img
                                                                    src="<%= image %>"
                                                                    class="shop-image"
                                                                    alt="<%= shop.shopName %>"
                                                                    onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22150%22%3E%3Crect fill=%22%23f0f0f0%22 width=%22300%22 height=%22150%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%23aaa%22 font-size=%2214%22%3ENo Image%3C/text%3E%3C/svg%3E'"
                                                                >

                                                            </div>


                                                        <% }) %>


                                                    </div>


                                                <% } %>


                                                <!-- Delete -->

                                                <div class="shop-delete-wrapper">

                                                    <form
                                                        action="/admin/shops/delete/<%= shop._id %>"
                                                        method="POST"
                                                        onsubmit="return confirm('Delete this shop? This cannot be undone.');"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="btn red waves-effect waves-light shop-delete-button"
                                                        >

                                                            <i class="material-icons left">

                                                                delete

                                                            </i>

                                                            Delete Shop

                                                        </button>

                                                    </form>

                                                </div>


                                            </div>

                                        </div>

                                    </div>


                                <% }) %>


                            <% } %>


                        </div>

                    </div>


                </div>

            </div>

        </div>

    </div>


    <!-- COMMON JS -->

    <%- include('_layouts/commonJs') %>


    <!-- CKEDITOR -->

    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>


    <script>

        document.addEventListener('DOMContentLoaded', function () {

            /* Materialize input labels */

            if (typeof M !== 'undefined') {

                M.updateTextFields();

            }


            /* CKEditor */

            const description = document.querySelector('#description');

            if (description) {

                ClassicEditor
                    .create(description)
                    .catch(function (error) {

                        console.error(error);

                    });

            }

        });

    </script>


</body>

</html>