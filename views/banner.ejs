<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>

    <%- include('_layouts/head') %>

    <title>Banners | <%= title %></title>


    <!-- DataTables CSS -->

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/vendors/data-tables/css/select.dataTables.min.css"
    >

    <link
        rel="stylesheet"
        type="text/css"
        href="/app-assets/css/pages/data-tables.css"
    >


    <style>

        /* =========================================
           BANNERS PAGE
           Same UI style as Careers page
        ========================================= */


        /* Table */

        table tr td,
        table tr th {

            text-align: center;

            vertical-align: middle !important;

            padding: 10px 8px !important;

        }


        /* Banner Image */

        .banner-image {

            width: 90px;

            height: 55px;

            object-fit: cover;

            border-radius: 5px;

            border: 1px solid #e0e0e0;

        }


        /* Banner Title */

        .banner-title {

            font-weight: 600;

            color: #333;

        }


        /* Position */

        .banner-position {

            padding: 16px 12px;

            border-radius: 20px;

            font-size: 0.8rem;

            font-weight: 600;

            display: inline-block;

            text-transform: capitalize;

            color: #fff;

            background: #26a69a;

            white-space: nowrap;

        }


        /* Display Order */

        .banner-order {

            font-weight: 500;

            color: #555;

        }


        /* Status */

        .banner-status {

            padding: 16px 12px;

            border-radius: 20px;

            font-size: 0.8rem;

            font-weight: 600;

            display: inline-block;

            text-transform: capitalize;

            color: #fff;

            white-space: nowrap;

        }


        .banner-status-active {

            background: #16a34a;

        }


        .banner-status-hidden {

            background: #757575;

        }


        /* Actions */

        .banner-actions {

            display: flex;

            gap: 6px;

            justify-content: center;

            align-items: center;

            flex-wrap: wrap;

        }


        .banner-actions .btn-floating {

            margin: 0;

        }


        /* Row hover */

        tr.banner-row {

            cursor: pointer;

        }


        tr.banner-row:hover {

            background: #f5f5f5;

        }


        td.actions-column {

            cursor: default;

        }


        /* Add Banner Button */

        .banner-add-wrapper {

            display: flex;

            justify-content: flex-end;

            padding: 6px 0;

            margin-bottom: 5px;

        }


        /* Empty State */

        .banner-empty {

            text-align: center !important;

            padding: 30px !important;

        }


        .banner-empty i {

            display: block;

            font-size: 36px;

            color: #bdbdbd;

            margin-bottom: 8px;

        }


        .banner-empty span {

            color: #9e9e9e;

        }


        /* Pagination */

        .banner-pagination {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 5px;

            margin-top: 20px;

        }


        .banner-pagination a {

            min-width: 32px;

            height: 32px;

            line-height: 32px;

            text-align: center;

            border-radius: 3px;

            color: #555;

            text-decoration: none;

            border: 1px solid #ddd;

            font-size: 13px;

        }


        .banner-pagination a:hover {

            background: #f5f5f5;

        }


        .banner-pagination a.active {

            background: #26a69a;

            border-color: #26a69a;

            color: #fff;

        }


        /* Responsive */

        @media (max-width: 768px) {

            .banner-add-wrapper {

                justify-content: flex-start;

            }


            table {

                min-width: 900px;

            }

        }

    </style>

</head>


<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click"
    data-menu="vertical-dark-menu"
    data-col="2-columns"
>


    <!-- SIDEBAR -->

    <%- include('_layouts/sidenavbar') %>


    <!-- MAIN -->

    <div id="main">

        <div class="row">


            <!-- =========================================
                 BREADCRUMB HEADER
            ========================================== -->

            <div
                class="pt-1 pb-0"
                id="breadcrumbs-wrapper"
            >

                <div class="container">

                    <div class="row">


                        <!-- MESSAGES -->

                        <%- include('messages', { messages: messages }) %>


                        <!-- PAGE TITLE -->

                        <div class="col s12 m6 l6">

                            <h6 class="breadcrumbs-title">

                                Manage Banners

                            </h6>

                        </div>


                        <!-- BREADCRUMBS -->

                        <div
                            class="col s12 m6 l6 right-align-md"
                            style="margin-top:-10px;"
                        >

                            <ol class="breadcrumbs mb-0">

                                <li class="breadcrumb-item">

                                    <a href="/admin/dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="breadcrumb-item active">

                                    Banners

                                </li>

                            </ol>

                        </div>

                    </div>


                    <!-- =====================================
                         ADD BANNER
                    ====================================== -->

                    <div class="banner-add-wrapper">

                        <a
                            class="btn btn-add btn-breadcrumbs white-text"
                            href="/admin/banners/add"
                        >

                            + Add Banner

                        </a>

                    </div>


                    <!-- =====================================
                         CARD HEADER
                    ====================================== -->

                    <div class="row">

                        <div class="col s12 m6">

                            <h5 class="mt-0">

                                Homepage Banners

                            </h5>


                            <p class="grey-text">

                                View and manage all homepage banners

                            </p>

                        </div>

                    </div>


                    <!-- =====================================
                         MAIN CONTENT
                    ====================================== -->

                    <div class="col s12">

                        <div class="container">

                            <div class="section section-data-tables">

                                <div class="row">

                                    <div class="col s12">


                                        <div class="card">

                                            <div class="card-content">


                                                <!-- =================================
                                                     TABLE
                                                ================================== -->

                                                <div class="row">

                                                    <div class="col s12 overflow">


                                                        <table
                                                            id="page-length-option"
                                                            class="display"
                                                        >

                                                            <thead>

                                                                <tr>

                                                                    <th>

                                                                        Image

                                                                    </th>


                                                                    <th>

                                                                        Title

                                                                    </th>


                                                                    <th>

                                                                        Position

                                                                    </th>


                                                                    <th>

                                                                        Order

                                                                    </th>


                                                                    <th>

                                                                        Status

                                                                    </th>


                                                                    <th>

                                                                        Actions

                                                                    </th>

                                                                </tr>

                                                            </thead>


                                                            <tbody>


                                                                <% if (!banners || banners.length === 0) { %>


                                                                    <!-- EMPTY STATE -->

                                                                    <tr>

                                                                        <td
                                                                            colspan="6"
                                                                            class="banner-empty"
                                                                        >

                                                                            <i class="material-icons">

                                                                                image

                                                                            </i>


                                                                            <span>

                                                                                No banners found

                                                                            </span>

                                                                        </td>

                                                                    </tr>


                                                                <% } else { %>


                                                                    <% banners.forEach(function(banner) { %>


                                                                        <tr
                                                                            class="banner-row"
                                                                        >


                                                                            <!-- =========================
                                                                                 IMAGE
                                                                            ========================== -->

                                                                            <td>

                                                                                <img
                                                                                    class="banner-image"
                                                                                    src="/uploads/banners/<%= banner.image %>"
                                                                                    onerror="this.src='https://via.placeholder.com/90x55?text=No+Image'"
                                                                                    alt="<%= banner.title || 'Banner' %>"
                                                                                />

                                                                            </td>


                                                                            <!-- =========================
                                                                                 TITLE
                                                                            ========================== -->

                                                                            <td>

                                                                                <span class="banner-title">

                                                                                    <%= banner.title || 'N/A' %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 POSITION
                                                                            ========================== -->

                                                                            <td>

                                                                                <span class="banner-position">

                                                                                    <%= banner.position || 'N/A' %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 ORDER
                                                                            ========================== -->

                                                                            <td>

                                                                                <span class="banner-order">

                                                                                    <%= banner.displayOrder ?? 0 %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 STATUS
                                                                            ========================== -->

                                                                            <td>

                                                                                <span
                                                                                    class="banner-status
                                                                                    <%= banner.isActive
                                                                                        ? 'banner-status-active'
                                                                                        : 'banner-status-hidden'
                                                                                    %>"
                                                                                >

                                                                                    <%= banner.isActive
                                                                                        ? 'Active'
                                                                                        : 'Hidden'
                                                                                    %>

                                                                                </span>

                                                                            </td>


                                                                            <!-- =========================
                                                                                 ACTIONS
                                                                            ========================== -->

                                                                            <td class="actions-column">

                                                                                <div class="banner-actions">


                                                                                    <!-- TOGGLE ACTIVE / HIDDEN -->

                                                                                    <form
                                                                                        action="/admin/banners/<%= banner._id %>/toggle-active"
                                                                                        method="POST"
                                                                                        style="display:inline;"
                                                                                    >

                                                                                        <button
                                                                                            type="submit"
                                                                                            class="btn-floating waves-effect waves-light <%= banner.isActive ? 'grey' : 'green' %>"
                                                                                            title="<%= banner.isActive ? 'Hide' : 'Show' %>"
                                                                                        >

                                                                                            <i class="material-icons">

                                                                                                <%= banner.isActive
                                                                                                    ? 'visibility_off'
                                                                                                    : 'visibility'
                                                                                                %>

                                                                                            </i>

                                                                                        </button>

                                                                                    </form>


                                                                                    <!-- DELETE -->

                                                                                    <a
                                                                                        href="#"
                                                                                        class="btn-floating waves-effect waves-light red btn-delete-banner"
                                                                                        data-id="<%= banner._id %>"
                                                                                        data-name="<%= banner.title || 'this banner' %>"
                                                                                        title="Delete"
                                                                                    >

                                                                                        <i class="material-icons">

                                                                                            delete

                                                                                        </i>

                                                                                    </a>


                                                                                </div>

                                                                            </td>


                                                                        </tr>


                                                                    <% }) %>


                                                                <% } %>


                                                            </tbody>

                                                        </table>


                                                    </div>

                                                </div>


                                                <!-- =================================
                                                     PAGINATION
                                                ================================== -->

                                                <% if (
                                                    typeof totalPages !== 'undefined' &&
                                                    totalPages > 1
                                                ) { %>


                                                    <div class="banner-pagination">


                                                        <% for (
                                                            let i = 1;
                                                            i <= totalPages;
                                                            i++
                                                        ) { %>


                                                            <a
                                                                href="/admin/banners?page=<%= i %>"
                                                                class="<%= currentPage === i ? 'active' : '' %>"
                                                            >

                                                                <%= i %>

                                                            </a>


                                                        <% } %>


                                                    </div>


                                                <% } %>


                                            </div>

                                        </div>


                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                </div>

            </div>


        </div>

    </div>


    <!-- =========================================
         COMMON JS
    ========================================== -->

    <%- include('_layouts/commonJs') %>


    <!-- =========================================
         DATATABLE JS
    ========================================== -->

    <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>

    <script src="/app-assets/js/scripts/data-tables.js"></script>


    <script>

        document.addEventListener('DOMContentLoaded', function () {


            /* =========================================
               DELETE BANNER
            ========================================= */

            document
                .querySelectorAll('.btn-delete-banner')
                .forEach(function (button) {


                    button.addEventListener('click', function (e) {

                        e.preventDefault();


                        const id =
                            this.dataset.id;


                        const name =
                            this.dataset.name;


                        if (!confirm(

                            'Delete banner "' +
                            name +
                            '"? This cannot be undone.'

                        )) {

                            return;

                        }


                        const form =
                            document.createElement('form');


                        form.method = 'POST';


                        form.action =
                            '/admin/banners/delete/' + id;


                        document.body.appendChild(form);


                        form.submit();

                    });

                });


        });

    </script>


</body>

</html>